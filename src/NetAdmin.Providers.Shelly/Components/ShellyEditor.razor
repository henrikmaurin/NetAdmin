@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Web
@using NetAdmin.Core.Models
@using NetAdmin.Core.Providers
@using NetAdmin.Providers.Shelly.Products
@inject ProductCatalogRegistry Catalog
@inject IShellyProvider ShellyProvider

@if (Device is ShellyHardwareDevice shelly)
{
    var shellyProducts = Catalog.GetProductsOfType<ShellyProductDefinition>();
    var selectedProduct = shellyProducts.FirstOrDefault(p => p.MatchesCodeOrModel(shelly.ShellyModel));

    <div class="card card--shelly">
        <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 0.75rem;">
            <h4 class="card-header">⚡ Shelly Device Properties</h4>
            <div style="display: flex; align-items: center; gap: 0.5rem;">
                <button type="button"
                        @onclick="() => ProbeFromDeviceAsync(shelly)"
                        disabled="@(_isProbing || string.IsNullOrWhiteSpace(shelly.IpAddress))"
                        title="Fetches product type, model code, generation and MAC address directly from the Shelly HTTP/RPC endpoint"
                        style="background: #0284c7; color: white; border: none; padding: 0.35rem 0.75rem; border-radius: 4px; font-size: 0.8rem; font-weight: 600; cursor: pointer;">
                    @(_isProbing ? "⏳ Probing device..." : "🔍 Probe Product Type from Device")
                </button>
            </div>
        </div>

        @InfoBox(_probeStatusMessage, _probeSuccess)

        <div class="card-grid">
            <div>
                <label class="form-label">Select Shelly Model (@shellyProducts.Count models)</label>
                <select value="@(selectedProduct?.ProductId ?? "")"
                        @onchange="@(e => OnCatalogProductSelected(shelly, e.Value?.ToString()))"
                        class="form-select">
                    <option value="">-- Select Shelly Model --</option>
                    @foreach (var group in shellyProducts.GroupBy(p => p.SubCategory))
                    {
                        <optgroup label="@group.Key">
                            @foreach (var prod in group)
                            {
                                <option value="@prod.ProductId">
                                    Shelly @prod.Model (Gen @prod.Generation@(prod.DefaultPortCount > 0 ? ", LAN" : ""))
                                </option>
                            }
                        </optgroup>
                    }
                </select>
            </div>

            <div>
                <label style="display: block; font-size: 0.75rem; font-weight: 600; margin-bottom: 0.25rem;">Shelly Model (or Device Code)</label>
                <input value="@shelly.ShellyModel"
                       @oninput="@(e => UpdateShelly(shelly with { ShellyModel = e.Value?.ToString() ?? "", Model = e.Value?.ToString() ?? "" }))"
                       placeholder="Plus 1PM / Pro 4PM / SNSW-001P16EU"
                       class="form-input" />
            </div>

            <div>
                <label style="display: block; font-size: 0.75rem; font-weight: 600; margin-bottom: 0.25rem;">Generation (Gen1 HTTP / Gen2–4 RPC)</label>
                <select value="@shelly.Generation"
                        @onchange="@(e => UpdateShelly(shelly with { Generation = int.TryParse(e.Value?.ToString(), out var g) ? g : 2 }))"
                        style="width: 100%; padding: 0.45rem; border: 1px solid #cbd5e1; border-radius: 4px;">
                    <option value="1">Gen 1 (HTTP REST API)</option>
                    <option value="2">Gen 2 / Plus / Pro (JSON-RPC API)</option>
                    <option value="3">Gen 3 (JSON-RPC API)</option>
                    <option value="4">Gen 4 (Multi-protocol Wi-Fi/Matter/Zigbee)</option>
                </select>
            </div>

            <div>
                <label style="display: block; font-size: 0.75rem; font-weight: 600; margin-bottom: 0.25rem;">Physical LAN Ports (0 = Wi-Fi, 1 = Pro LAN)</label>
                <input type="number" min="0" max="4"
                       value="@shelly.PortCount"
                       @onchange="@(e => UpdateShelly(shelly with { PortCount = int.TryParse(e.Value?.ToString(), out var p) ? p : 0 }))"
                       style="width: 100%; padding: 0.45rem; border: 1px solid #cbd5e1; border-radius: 4px;" />
            </div>
        </div>

        @if (selectedProduct is not null)
        {
            <div style="margin-top: 0.75rem; padding-top: 0.5rem; border-top: 1px dashed #bae6fd; font-size: 0.8rem; color: #0c4a6e; display: flex; justify-content: space-between; flex-wrap: wrap; gap: 0.5rem;">
                <span>
                    <strong>@selectedProduct.GetType().Name:</strong> @selectedProduct.Description
                    (Codes: <code>@string.Join(", ", selectedProduct.DeviceCodes)</code>)
                </span>
                <span>
                    Channels: <strong>@selectedProduct.RelayChannels</strong> |
                    Power Metering: <strong>@(selectedProduct.HasPowerMetering ? "Yes (PM)" : "No")</strong> |
                    DIN Rail: <strong>@(selectedProduct.IsDinRailMountable ? "Yes" : "No")</strong>
                </span>
            </div>
        }
    </div>
}

@inherits NetAdmin.Core.Components.TypedDeviceComponentBase<NetAdmin.Core.Models.ShellyHardwareDevice>

@code {
    private bool _isProbing;
    private bool _probeSuccess;
    private string? _probeStatusMessage;

    private Task OnCatalogProductSelected(ShellyHardwareDevice current, string? productId)
    {
        if (string.IsNullOrWhiteSpace(productId))
            return Task.CompletedTask;

        var product = Catalog.GetById(productId);
        if (product is null)
            return Task.CompletedTask;

        var updated = (ShellyHardwareDevice)product.ApplyToDevice(current);
        return UpdateShelly(updated);
    }

    private async Task ProbeFromDeviceAsync(ShellyHardwareDevice current)
    {
        if (string.IsNullOrWhiteSpace(current.IpAddress))
            return;

        _isProbing = true;
        _probeStatusMessage = null;

        try
        {
            var info = await ShellyProvider.ProbeDeviceAsync(current.IpAddress);
            if (info is null)
            {
                _probeSuccess = false;
                _probeStatusMessage = $"Could not reach Shelly device at http://{current.IpAddress}/shelly.";
                return;
            }

            var updated = current with
            {
                Name = string.IsNullOrWhiteSpace(current.Name) || current.Name == "New Shelly Device" || current.Name == "Ny Shelly-enhet"
                    ? (!string.IsNullOrWhiteSpace(info.DeviceName) ? info.DeviceName : $"Shelly {info.FriendlyModel}")
                    : current.Name,
                MacAddress = string.IsNullOrWhiteSpace(current.MacAddress) && !string.IsNullOrWhiteSpace(info.MacAddress)
                    ? info.MacAddress
                    : current.MacAddress,
                ShellyModel = info.FriendlyModel,
                Model = info.FriendlyModel,
                Generation = info.Generation,
                PortCount = info.EffectivePortCount,
                TagsCsv = info.EffectiveTagsCsv
            };

            _probeSuccess = true;
            _probeStatusMessage = info.MatchedProduct is not null
                ? $"✅ Identified from device: Shelly {info.FriendlyModel} (Class: {info.MatchedProduct.GetType().Name}, Code: {info.RawModelCode}, Gen {info.Generation}, MAC: {info.MacAddress ?? "-"})"
                : $"✅ Device responded: Model code '{info.RawModelCode}' (App: {info.AppCode ?? "-"}, Gen {info.Generation}, MAC: {info.MacAddress ?? "-"})";

            await UpdateShelly(updated);
        }
        finally
        {
            _isProbing = false;
        }
    }

    private Task UpdateShelly(ShellyHardwareDevice updated)
    {
        return NotifyDeviceChanged(updated);
    }
}
