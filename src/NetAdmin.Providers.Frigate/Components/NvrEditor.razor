@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Web
@using NetAdmin.Core.Models
@using NetAdmin.Core.Providers
@inherits NetAdmin.Core.Components.CatalogDeviceEditorBase<HardwareDevice>
@inject IFrigateProvider FrigateProvider
@inject NetAdmin.Core.Models.IHardwareInventoryProvider HardwareProvider

@{
    var vendors = GetCatalogVendors();
    var vendorSelectValue = GetVendorSelectValue(Device.Vendor);
    var vendorModels = GetVendorModels(Device.Vendor);
    var selectedProduct = GetSelectedProduct(Device.Vendor, Device.Model);
    var modelSelectValue = GetModelSelectValue(Device.Vendor, Device.Model);
}

<div class="card card--accent">
    <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 0.75rem;">
        <h4 class="card-header" style="margin: 0;">🎥 NVR & Frigate Properties</h4>
        <button type="button"
                @onclick="ProbeFrigateAsync"
                disabled="@_isProbing"
                style="background: #0284c7; color: white; border: none; padding: 0.35rem 0.75rem; border-radius: 4px; font-size: 0.8rem; font-weight: 600; cursor: pointer;">
            @(_isProbing ? "⏳ Querying Frigate..." : "🔍 Query Frigate Status (/api/stats)")
        </button>
    </div>
        <!-- Simple go2rtc helper: add/remove camera source so Frigate can consume it -->
        <div style="margin-top:0.75rem; padding:0.65rem; background:#f1f5f9; border:1px solid #e2e8f0; border-radius:6px;">
            <strong>Manage go2rtc Sources (optional)</strong>
            <div style="display:flex; gap:0.5rem; margin-top:0.5rem; flex-wrap:wrap;">
                <input placeholder="Camera name" @bind="_newCameraName" class="form-input" style="min-width:200px;" />
                <input placeholder="rtsp://... or http://..." @bind="_newCameraRtsp" class="form-input" style="min-width:320px;" />
                <input placeholder="go2rtc base URL (optional)" @bind="_go2rtcBase" class="form-input" style="min-width:220px;" />
                <label style="display:flex; align-items:center; gap:0.4rem; margin-left:0.25rem;">
                    <input type="checkbox" @bind="_alsoAddToFrigate" />
                    <span style="font-size:0.9rem; color:#334155;">Also add camera to Frigate</span>
                </label>
                <button class="btn" @onclick="AddCameraViaGo2RtcAsync" disabled="@(_isAddingCamera || string.IsNullOrWhiteSpace(_newCameraName) || string.IsNullOrWhiteSpace(_newCameraRtsp))">
                    @(_isAddingCamera ? "⏳ Adding..." : "➕ Add to go2rtc")
                </button>
                <button class="btn btn--danger" @onclick="RemoveCameraViaGo2RtcAsync" disabled="@(_isRemovingCamera || string.IsNullOrWhiteSpace(_newCameraName))">
                    @(_isRemovingCamera ? "⏳ Removing..." : "🗑️ Remove from go2rtc")
                </button>
                <button class="btn" @onclick="OpenImportModalAsync" disabled="@(_statusSummary is null)">
                    🔗 Link / sync Frigate cameras
                </button>
            </div>
            @if (!string.IsNullOrWhiteSpace(_cameraActionMessage))
            {
                <div style="margin-top:0.5rem; font-size:0.9rem;">@_cameraActionMessage</div>
            }
        </div>

    @InfoBox(_statusMessage, _statusSuccess)

    @if (_statusSummary is not null && _statusSummary.Cameras.Count > 0)
    {
        <div style="margin-bottom: 0.85rem; padding: 0.65rem; background: #f8fafc; border: 1px solid #cbd5e1; border-radius: 6px; font-size: 0.82rem;">
            <strong>Connected Frigate Cameras (@_statusSummary.CameraCount):</strong>
            <div style="display: flex; flex-wrap: wrap; gap: 0.4rem; margin-top: 0.4rem;">
                @foreach (var cam in _statusSummary.Cameras)
                {
                    <span style="background: #e0f2fe; color: #0369a1; padding: 0.2rem 0.5rem; border-radius: 4px; font-weight: 600;">
                        📹 @cam.Name (@cam.CameraFps.ToString("0.0") fps)
                    </span>
                }
            </div>
        </div>
    }

    @if (_showImportModal)
    {
        <div style="position: fixed; inset: 0; background: rgba(0,0,0,0.4); display:flex; align-items:center; justify-content:center; z-index:50;">
            <div style="background:white; padding:1rem; border-radius:8px; width:900px; max-width:95%;">
                <h3 style="margin-top:0;">Link Frigate cameras to inventory</h3>
                <div style="max-height: 60vh; overflow:auto; margin-bottom:0.75rem;">
                    @if (_importCandidates.Count == 0)
                    {
                        <p>No Frigate camera definitions were found. Check the Frigate connection and camera configuration.</p>
                    }
                    @foreach (var candidate in _importCandidates)
                    {
                        <div style="padding:0.6rem; border-bottom:1px solid #eef2f7;">
                            <div style="display:flex; gap:0.5rem; align-items:center;">
                                <input type="checkbox" checked="@candidate.Selected" @onchange="@(e => UpdateImportCandidate(candidate, candidate with { Selected = (bool?)e.Value == true }))" />
                                <strong>@candidate.Name</strong>
                                <span style="font-size:0.75rem; padding:0.15rem 0.4rem; border-radius:12px; background:@(candidate.Status == "Linked" ? "#dcfce7" : "#eef2ff"); color:@(candidate.Status == "Linked" ? "#166534" : "#1e3a8a"); font-weight:600;">@candidate.Status</span>
                            </div>
                            <label class="form-label" style="margin:0.4rem 0 0.2rem 1.6rem;">Inventory camera</label>
                            <select class="form-select" style="margin-left:1.6rem; width:calc(100% - 1.6rem);" value="@candidate.TargetHardwareId" @onchange="@(e => UpdateImportCandidate(candidate, candidate with { TargetHardwareId = e.Value?.ToString() ?? string.Empty }))">
                                <option value="">Create a new camera</option>
                                @foreach (var camera in _availableCameras)
                                {
                                    <option value="@camera.Id" disabled="@IsCameraAssignedToOtherCandidate(camera.Id, candidate)">@camera.Name@(string.IsNullOrWhiteSpace(camera.IpAddress) ? "" : $" — {camera.IpAddress}")</option>
                                }
                            </select>
                            <div style="font-size:0.82rem; color:#64748b; margin:0.3rem 0 0 1.6rem;">
                                @if (candidate.Streams.Count == 0)
                                {
                                    <span>No configured FFmpeg stream inputs.</span>
                                }
                                else
                                {
                                    @foreach (var stream in candidate.Streams)
                                    {
                                        <div>@stream.Name (@stream.Protocol): @stream.Url</div>
                                    }
                                }
                            </div>
                        </div>
                    }
                </div>
                <div style="display:flex; justify-content:flex-end; gap:0.5rem;">
                    <button class="btn btn--ghost" @onclick="CancelImport">Cancel</button>
                    <button class="btn" @onclick="ImportSelectedAsync" disabled="@(_isSyncing || !_importCandidates.Any(candidate => candidate.Selected))">@(_isSyncing ? "Syncing..." : $"Sync Selected ({_importCandidates.Count(candidate => candidate.Selected)})")</button>
                </div>
            </div>
        </div>
    }

    <!-- moved camera helper methods into code block below -->

    <div class="card-grid">
        <div>
            <label class="form-label">1. Manufacturer (Catalog)</label>
            <select value="@vendorSelectValue"
                    @onchange="@(e => OnVendorSelectedAsync(e.Value?.ToString()))"
                    class="form-select">
                @foreach (var vendor in vendors)
                {
                    <option value="@vendor">@vendor</option>
                }
                <option value="__custom__">-- Custom / Other Manufacturer --</option>
            </select>
        </div>

        <div>
            <label class="form-label">2. Model (Catalog)</label>
            <select value="@modelSelectValue"
                    @onchange="@(e => OnCatalogProductSelectedAsync(e.Value?.ToString()))"
                    class="form-select">
                @foreach (var prod in vendorModels)
                {
                    <option value="@prod.ProductId">@prod.Model</option>
                }
                <option value="__custom__">-- Custom / Other Model --</option>
            </select>
        </div>

        <div>
            <label class="form-label">Manufacturer (Free Text)</label>
            <input value="@Device.Vendor"
                   @oninput="@(e => OnCustomVendorInputAsync(e.Value?.ToString() ?? ""))"
                   placeholder="Frigate / Reolink / Ubiquiti"
                   class="form-input" />
        </div>

        <div>
            <label class="form-label">Model (Free Text)</label>
            <input value="@Device.Model"
                   @oninput="@(e => OnCustomModelInputAsync(e.Value?.ToString() ?? ""))"
                   placeholder="Frigate NVR / RLN8-410"
                   class="form-input" />
        </div>

        <div>
            <label class="form-label">Physical Network Ports</label>
            <input type="number" min="0" max="16"
                   value="@Device.PortCount"
                   @onchange="@(e => NotifyDeviceChanged(Device with { PortCount = int.TryParse(e.Value?.ToString(), out var p) ? p : 1 }))"
                   class="form-input" />
        </div>
    </div>

    @if (selectedProduct is not null)
    {
        <div style="margin-top: 0.75rem; padding-top: 0.5rem; border-top: 1px dashed #cbd5e1; font-size: 0.8rem; color: #334155;">
            <strong>@selectedProduct.FullName:</strong> @selectedProduct.Description
        </div>
    }
</div>

@code {
    protected override HardwareCategory TargetCategory => HardwareCategory.Nvr;

    private bool _isProbing;
    private bool _statusSuccess;
    private string? _statusMessage;
    private FrigateStatusSummary? _statusSummary;
    private string _newCameraName = string.Empty;
    private string _newCameraRtsp = string.Empty;
    private string _go2rtcBase = string.Empty;
    private bool _alsoAddToFrigate;
    private bool _isAddingCamera;
    private bool _isRemovingCamera;
    private string? _cameraActionMessage;
    private bool _showImportModal;
    private bool _isSyncing;
    private List<FrigateImportCandidate> _importCandidates = [];
    private List<CameraHardwareDevice> _availableCameras = [];
    private HashSet<string> _existingHardwareIds = new(StringComparer.OrdinalIgnoreCase);

    private sealed record FrigateImportCandidate(
        string Name,
        IReadOnlyList<CameraStreamDefinition> Streams,
        bool Selected,
        string TargetHardwareId,
        string Status);

    private async Task AddCameraViaGo2RtcAsync()
    {
        _isAddingCamera = true;
        _cameraActionMessage = null;
        try
        {
            var ok = await FrigateProvider.AddCameraViaGo2RtcAsync(Device.Id, _newCameraName, _newCameraRtsp, string.IsNullOrWhiteSpace(_go2rtcBase) ? null : _go2rtcBase);
            var messages = new List<string>();
            messages.Add(ok ? "✅ Camera added to go2rtc." : "❌ Failed to add camera to go2rtc.");

            if (ok && _alsoAddToFrigate)
            {
                var fk = await FrigateProvider.AddCameraToFrigateAsync(Device.Id, _newCameraName, _newCameraRtsp);
                messages.Add(fk ? "✅ Camera added to Frigate config." : "❌ Failed to add camera to Frigate config.");
            }

            _cameraActionMessage = string.Join(" ", messages);
            if (ok)
                await ProbeFrigateAsync();
        }
        finally
        {
            _isAddingCamera = false;
        }
    }

    private async Task RemoveCameraViaGo2RtcAsync()
    {
        _isRemovingCamera = true;
        _cameraActionMessage = null;
        try
        {
            var ok = await FrigateProvider.RemoveCameraViaGo2RtcAsync(Device.Id, _newCameraName, string.IsNullOrWhiteSpace(_go2rtcBase) ? null : _go2rtcBase);
            var messages = new List<string>();
            messages.Add(ok ? "✅ Camera removed from go2rtc." : "❌ Failed to remove camera from go2rtc.");

            if (ok && _alsoAddToFrigate)
            {
                var fk = await FrigateProvider.RemoveCameraFromFrigateAsync(Device.Id, _newCameraName);
                messages.Add(fk ? "✅ Camera removed from Frigate config." : "❌ Failed to remove camera from Frigate config.");
            }

            _cameraActionMessage = string.Join(" ", messages);
            if (ok)
                await ProbeFrigateAsync();
        }
        finally
        {
            _isRemovingCamera = false;
        }
    }

    private string SanitizeId(string input)
    {
        if (string.IsNullOrWhiteSpace(input)) return Guid.NewGuid().ToString("N");
        var s = input.ToLowerInvariant();
        var sb = new System.Text.StringBuilder();
        foreach (var c in s)
        {
            if (char.IsLetterOrDigit(c) || c == '-') sb.Append(c);
            else if (char.IsWhiteSpace(c) || c == '_' || c == '.') sb.Append('-');
        }
        var outS = sb.ToString();
        if (string.IsNullOrWhiteSpace(outS)) return Guid.NewGuid().ToString("N");
        return outS;
    }

    private async Task OpenImportModalAsync()
    {
        _cameraActionMessage = null;
        var definitions = await FrigateProvider.GetCameraDefinitionsAsync(Device.Id);
        var existingHardware = await HardwareProvider.GetAllHardwareAsync();
        _existingHardwareIds = existingHardware.Select(hardware => hardware.Id).ToHashSet(StringComparer.OrdinalIgnoreCase);
        _availableCameras = existingHardware.OfType<CameraHardwareDevice>().ToList();
        var assignedCameraIds = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
        _importCandidates = definitions.Select(definition =>
        {
            var matchingCamera = FindMatchingCamera(definition, assignedCameraIds);
            if (matchingCamera is not null)
                assignedCameraIds.Add(matchingCamera.Id);

            return new FrigateImportCandidate(
                definition.Name,
                definition.Streams,
                Selected: true,
                TargetHardwareId: matchingCamera?.Id ?? string.Empty,
                Status: string.Equals(matchingCamera?.NvrId, Device.Id, StringComparison.OrdinalIgnoreCase) ? "Linked" : matchingCamera is null ? "New" : "Match");
        }).ToList();
        _showImportModal = true;
    }

    private CameraHardwareDevice? FindMatchingCamera(FrigateCameraDefinition definition, ISet<string> assignedCameraIds)
    {
        var byNvrAndName = _availableCameras.FirstOrDefault(camera =>
            string.Equals(camera.NvrId, Device.Id, StringComparison.OrdinalIgnoreCase) &&
            string.Equals(camera.Name, definition.Name, StringComparison.OrdinalIgnoreCase) &&
            !assignedCameraIds.Contains(camera.Id));
        if (byNvrAndName is not null)
            return byNvrAndName;

        var streamUrls = definition.Streams.Select(stream => stream.Url).ToHashSet(StringComparer.OrdinalIgnoreCase);
        var byStream = _availableCameras.FirstOrDefault(camera =>
            !assignedCameraIds.Contains(camera.Id) &&
            camera.EffectiveStreams.Any(stream => streamUrls.Contains(stream.Url)));
        if (byStream is not null)
            return byStream;

        return _availableCameras.FirstOrDefault(camera =>
            !assignedCameraIds.Contains(camera.Id) &&
            string.Equals(camera.Name, definition.Name, StringComparison.OrdinalIgnoreCase));
    }

    private bool IsCameraAssignedToOtherCandidate(string cameraId, FrigateImportCandidate candidate) =>
        _importCandidates.Any(other => !ReferenceEquals(other, candidate) &&
                                       other.Selected &&
                                       string.Equals(other.TargetHardwareId, cameraId, StringComparison.OrdinalIgnoreCase));

    private void UpdateImportCandidate(FrigateImportCandidate original, FrigateImportCandidate updated)
    {
        var index = _importCandidates.IndexOf(original);
        if (index >= 0)
            _importCandidates[index] = updated;
    }

    private async Task ImportSelectedAsync()
    {
        if (_isSyncing)
            return;

        var created = 0;
        var linked = 0;
        var updated = 0;
        _isSyncing = true;

        try
        {
            var selectedCandidates = _importCandidates.Where(candidate => candidate.Selected).ToList();
            var duplicateCameraId = selectedCandidates
                .Where(candidate => !string.IsNullOrWhiteSpace(candidate.TargetHardwareId))
                .GroupBy(candidate => candidate.TargetHardwareId, StringComparer.OrdinalIgnoreCase)
                .FirstOrDefault(group => group.Count() > 1)?.Key;
            if (duplicateCameraId is not null)
                throw new InvalidOperationException($"Inventory camera '{duplicateCameraId}' is assigned to multiple Frigate cameras.");

            var unavailableCameraId = selectedCandidates
                .Where(candidate => !string.IsNullOrWhiteSpace(candidate.TargetHardwareId))
                .Select(candidate => candidate.TargetHardwareId)
                .FirstOrDefault(id => _availableCameras.All(camera => !string.Equals(camera.Id, id, StringComparison.OrdinalIgnoreCase)));
            if (unavailableCameraId is not null)
                throw new InvalidOperationException($"The selected camera '{unavailableCameraId}' is no longer available.");

            foreach (var candidate in selectedCandidates)
            {
                if (string.IsNullOrWhiteSpace(candidate.TargetHardwareId))
                {
                    await HardwareProvider.SaveHardwareAsync(CreateCamera(candidate));
                    created++;
                    continue;
                }

                var camera = _availableCameras.FirstOrDefault(item => string.Equals(item.Id, candidate.TargetHardwareId, StringComparison.OrdinalIgnoreCase))
                    ?? throw new InvalidOperationException($"The selected camera '{candidate.TargetHardwareId}' is no longer available.");
                var wasLinked = string.Equals(camera.NvrId, Device.Id, StringComparison.OrdinalIgnoreCase);
                await HardwareProvider.SaveHardwareAsync(LinkCamera(camera, candidate));
                if (wasLinked)
                    updated++;
                else
                    linked++;
            }

            _cameraActionMessage = $"Synced {created} new camera(s), linked {linked} existing camera(s), and refreshed {updated} linked camera(s).";
            _showImportModal = false;
            _importCandidates.Clear();
        }
        catch (InvalidOperationException exception)
        {
            _cameraActionMessage = $"Camera sync failed: {exception.Message}";
        }
        finally
        {
            _isSyncing = false;
        }
    }

    private CameraHardwareDevice LinkCamera(CameraHardwareDevice camera, FrigateImportCandidate candidate)
    {
        var streams = camera.EffectiveStreams.ToList();
        foreach (var stream in candidate.Streams)
        {
            if (!streams.Any(existing => string.Equals(existing.Url, stream.Url, StringComparison.OrdinalIgnoreCase)))
                streams.Add(stream);
        }

        var frigateTag = $"frigate:{Device.Id}";
        var tags = camera.TagsCsv.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).ToList();
        if (!tags.Contains("frigate", StringComparer.OrdinalIgnoreCase))
            tags.Add("frigate");
        if (!tags.Contains(frigateTag, StringComparer.OrdinalIgnoreCase))
            tags.Add(frigateTag);

        return camera with
        {
            NvrId = Device.Id,
            RtspPath = string.IsNullOrWhiteSpace(camera.RtspPath) ? candidate.Streams.FirstOrDefault()?.Url : camera.RtspPath,
            Streams = streams,
            TagsCsv = string.Join(", ", tags),
            Notes = AppendImportedNote(camera.Notes)
        };
    }

    private CameraHardwareDevice CreateCamera(FrigateImportCandidate candidate)
    {
        var idBase = SanitizeId($"frigate-{Device.Id}-{candidate.Name}");
        var id = idBase;
        var suffix = 2;
        while (_existingHardwareIds.Contains(id))
            id = $"{idBase}-{suffix++}";
        _existingHardwareIds.Add(id);

        var streams = candidate.Streams.ToList();
        return new CameraHardwareDevice(
            Id: id,
            Name: candidate.Name,
            IpAddress: null,
            MacAddress: null,
            Room: "",
            Vendor: "",
            Model: "",
            PortCount: 1,
            RtspPath: streams.FirstOrDefault()?.Url,
            Notes: $"Imported from Frigate NVR {Device.Id}",
            NvrId: Device.Id,
            TagsCsv: $"camera, frigate, frigate:{Device.Id}",
            Streams: streams);
    }

    private static string AppendImportedNote(string notes)
    {
        const string importedNote = "Imported from Frigate";
        return notes.Contains(importedNote, StringComparison.OrdinalIgnoreCase)
            ? notes
            : string.IsNullOrWhiteSpace(notes) ? importedNote : $"{notes}; {importedNote}";
    }

    private void CancelImport()
    {
        _showImportModal = false;
        _importCandidates.Clear();
    }

    private async Task ProbeFrigateAsync()
    {
        _isProbing = true;
        _statusMessage = null;

        try
        {
            var targetUrl = !string.IsNullOrWhiteSpace(Device.ManagementUrl) ? Device.ManagementUrl : Device.IpAddress;
            _statusSummary = await FrigateProvider.GetStatusAsync(Device.Id, targetUrl);

            if (_statusSummary is not null)
            {
                _statusSuccess = true;
                var detText = _statusSummary.Detectors.Count > 0 ? string.Join(", ", _statusSummary.Detectors) : "default";
                _statusMessage = $"Frigate v{_statusSummary.Version} online — {_statusSummary.CameraCount} camera(s), detectors: {detText}.";
            }
            else
            {
                _statusSuccess = false;
                _statusMessage = "Could not reach Frigate API (/api/stats). Verify IP/Base URL or credentials below.";
            }
        }
        finally
        {
            _isProbing = false;
        }
    }
}
