@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Web
@using NetAdmin.Core.Models

@if (Device is FiberConverterHardwareDevice fiber)
{
    <div class="card card--green">
        <h4 class="card-header">🔦 Fiber Converter Properties</h4>
        <div class="card-grid">
            <div>
                <label class="form-label">Manufacturer / Network</label>
                <input value="@fiber.Vendor"
                       @oninput="@(e => UpdateFiber(fiber with { Vendor = e.Value?.ToString() ?? "" }))"
                       placeholder="City Network / Inteno / Genexis"
                       class="form-input" />
            </div>
            <div>
                <label style="display: block; font-size: 0.75rem; font-weight: 600; margin-bottom: 0.25rem;">CPE / ONT Model</label>
                <input value="@fiber.ConverterModel"
                       @oninput="@(e => UpdateFiber(fiber with { ConverterModel = e.Value?.ToString() ?? "", Model = e.Value?.ToString() ?? "" }))"
                       placeholder="CPE / ONT"
                       style="width: 100%; padding: 0.45rem; border: 1px solid #cbd5e1; border-radius: 4px;" />
            </div>
            <div>
                <label style="display: block; font-size: 0.75rem; font-weight: 600; margin-bottom: 0.25rem;">Physical Ports (Fiber + LAN)</label>
                <input type="number" min="1" max="16"
                       value="@fiber.PortCount"
                       @onchange="@(e => UpdateFiber(fiber with { PortCount = int.TryParse(e.Value?.ToString(), out var p) ? p : 5 }))"
                       style="width: 100%; padding: 0.45rem; border: 1px solid #cbd5e1; border-radius: 4px;" />
            </div>
        </div>
    </div>
}

@inherits NetAdmin.Core.Components.TypedDeviceComponentBase<NetAdmin.Core.Models.FiberConverterHardwareDevice>

@code {
    private Task UpdateFiber(FiberConverterHardwareDevice updated) => NotifyDeviceChanged(updated);
}
