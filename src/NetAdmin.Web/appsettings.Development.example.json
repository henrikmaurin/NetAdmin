{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "OpnSense": {
    "BaseUrl": "https://192.168.1.1",
    "ApiKey": "YOUR_OPNSENSE_API_KEY",
    "ApiSecret": "YOUR_OPNSENSE_API_SECRET",
    "IgnoreSslErrors": true
  },
  "UniFi": {
    "BaseUrl": "https://unifi-controller:8443",
    "Site": "default",
    "Username": "YOUR_UNIFI_USERNAME",
    "Password": "YOUR_UNIFI_PASSWORD",
    "IsUniFiOs": false,
    "IgnoreSslErrors": true
  }
}
