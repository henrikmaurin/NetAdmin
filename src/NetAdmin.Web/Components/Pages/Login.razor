@page "/login"
@using NetAdmin.Core.Services
@inject IAdminAuthService AuthService
@inject NavigationManager Navigation

<PageTitle>NetAdmin - Sign In</PageTitle>

<div style="font-family: system-ui, sans-serif; min-height: 85vh; display: flex; align-items: center; justify-content: center; padding: 1.5rem;">
    <div style="width: 100%; max-width: 420px; background: white; border: 1px solid #cbd5e1; border-radius: 12px; padding: 2rem; box-shadow: 0 4px 12px rgba(15, 23, 42, 0.06);">
        <div style="text-align: center; margin-bottom: 1.75rem;">
            <div style="font-size: 2.25rem; margin-bottom: 0.4rem;">🛡️</div>
            <h1 style="margin: 0; font-size: 1.5rem; color: #0f172a;">NetAdmin Sign In</h1>
            <p style="margin: 0.35rem 0 0 0; font-size: 0.88rem; color: #64748b;">
                Sign in with your administrator account to manage the network.
            </p>
        </div>

        @if (Error == 1)
        {
            <div style="padding: 0.75rem 1rem; border-radius: 6px; margin-bottom: 1.25rem; background: #fef2f2; border: 1px solid #f87171; color: #991b1b; font-size: 0.85rem;">
                ❌ Invalid username or password. Please try again.
            </div>
        }

        <form method="post" action="/auth/login">
            <input type="hidden" name="returnUrl" value="@(ReturnUrl ?? "/")" />

            <div style="margin-bottom: 1rem;">
                <label style="display: block; font-size: 0.85rem; font-weight: 600; color: #334155; margin-bottom: 0.35rem;">Username</label>
                <input name="username"
                       value="@_defaultUsername"
                       required
                       autocomplete="username"
                       placeholder="admin"
                       style="width: 100%; padding: 0.6rem 0.75rem; border: 1px solid #cbd5e1; border-radius: 6px; font-size: 0.95rem; box-sizing: border-box;" />
            </div>

            <div style="margin-bottom: 1.5rem;">
                <label style="display: block; font-size: 0.85rem; font-weight: 600; color: #334155; margin-bottom: 0.35rem;">Password</label>
                <input name="password"
                       type="password"
                       required
                       autocomplete="current-password"
                       placeholder="••••••••"
                       style="width: 100%; padding: 0.6rem 0.75rem; border: 1px solid #cbd5e1; border-radius: 6px; font-size: 0.95rem; box-sizing: border-box;" />
            </div>

            <button type="submit"
                    style="width: 100%; padding: 0.7rem 1rem; background: #0284c7; color: white; border: none; border-radius: 6px; font-weight: 600; font-size: 0.95rem; cursor: pointer;">
                🔐 Sign In
            </button>
        </form>
    </div>
</div>

@code {
    [SupplyParameterFromQuery(Name = "error")]
    public int? Error { get; set; }

    [SupplyParameterFromQuery(Name = "returnUrl")]
    public string? ReturnUrl { get; set; }

    private string _defaultUsername = "admin";

    protected override async Task OnInitializedAsync()
    {
        if (!await AuthService.IsOnboardingCompletedAsync())
        {
            Navigation.NavigateTo("/onboarding", forceLoad: true);
            return;
        }

        _defaultUsername = await AuthService.GetAdminUsernameAsync() ?? "admin";
    }
}
