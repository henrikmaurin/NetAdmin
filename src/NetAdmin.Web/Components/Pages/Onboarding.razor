@page "/onboarding"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.DataProtection
@using NetAdmin.Core.Providers
@using NetAdmin.Core.Services
@using NetAdmin.Core.Models
@inject IAdminAuthService AuthService
@inject IEncryptedSettingsService SettingsService
@inject IEnumerable<IRoutingProvider> RoutingProviders
@inject IEnumerable<IWirelessProvider> WirelessProviders
@inject IDataProtectionProvider ProtectionProvider
@inject NavigationManager Navigation
@inject IHardwareInventoryProvider HardwareProvider

<PageTitle>NetAdmin - Welcome & Onboarding</PageTitle>

<div style="font-family: system-ui, sans-serif; max-width: 820px; margin: 2rem auto; padding: 1.5rem;">
    <div style="text-align: center; margin-bottom: 2rem;">
        <h1 style="margin: 0; color: #0f172a;">Welcome to NetAdmin</h1>
        <p style="color: #64748b; margin: 0.4rem 0 0 0;">Complete the initial setup to secure your system and connect your network integrations.</p>
    </div>

    <!-- Step Indicator -->
    <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 0.75rem; margin-bottom: 2rem;">
        <div style="padding: 0.75rem 1rem; border-radius: 8px; border: 2px solid @(_step == 1 ? "#0284c7" : (_step > 1 ? "#16a34a" : "#e2e8f0")); background: @(_step == 1 ? "#f0f9ff" : (_step > 1 ? "#f0fdf4" : "#f8fafc"));">
            <div style="font-size: 0.75rem; font-weight: 700; color: @(_step == 1 ? "#0284c7" : (_step > 1 ? "#166534" : "#64748b"));">STEP 1</div>
            <div style="font-weight: 600; color: #0f172a; margin-top: 0.15rem;">@(_step > 1 ? "✓ " : "")Create Admin Account</div>
        </div>
        <div style="padding: 0.75rem 1rem; border-radius: 8px; border: 2px solid @(_step == 2 ? "#0284c7" : (_step > 2 ? "#16a34a" : "#e2e8f0")); background: @(_step == 2 ? "#f0f9ff" : (_step > 2 ? "#f0fdf4" : "#f8fafc"));">
            <div style="font-size: 0.75rem; font-weight: 700; color: @(_step == 2 ? "#0284c7" : (_step > 2 ? "#166534" : "#64748b"));">STEP 2</div>
            <div style="font-weight: 600; color: #0f172a; margin-top: 0.15rem;">@(_step > 2 ? "✓ " : "")Configure Integrations</div>
        </div>
        <div style="padding: 0.75rem 1rem; border-radius: 8px; border: 2px solid @(_step == 3 ? "#0284c7" : "#e2e8f0"); background: @(_step == 3 ? "#f0f9ff" : "#f8fafc");">
            <div style="font-size: 0.75rem; font-weight: 700; color: @(_step == 3 ? "#0284c7" : "#64748b");">STEP 3</div>
            <div style="font-weight: 600; color: #0f172a; margin-top: 0.15rem;">Ready to Launch</div>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(_errorMessage))
    {
        <div style="padding: 0.85rem 1rem; border-radius: 6px; margin-bottom: 1.25rem; background: #fef2f2; border: 1px solid #f87171; color: #991b1b;">
            @_errorMessage
        </div>
    }

    @if (_step == 1)
    {
        <div style="background: white; border: 1px solid #cbd5e1; border-radius: 10px; padding: 1.75rem;">
            <h2 style="margin-top: 0; color: #0f172a;">👤 Step 1: Create System Administrator Account</h2>
            <p style="font-size: 0.9rem; color: #64748b; margin-bottom: 1.25rem;">
                Create the local administrator account required to access and administer NetAdmin. Credentials are hashed with PBKDF2-SHA256 and encrypted at rest.
            </p>

            <div style="display: grid; grid-template-columns: 1fr; gap: 1rem; max-width: 480px;">
                <div>
                    <label style="display: block; font-size: 0.85rem; font-weight: 600; margin-bottom: 0.3rem;">Administrator Username</label>
                    <input @bind="_adminUsername"
                           placeholder="admin"
                           style="width: 100%; padding: 0.55rem 0.75rem; border: 1px solid #cbd5e1; border-radius: 6px;" />
                </div>
                <div>
                    <label style="display: block; font-size: 0.85rem; font-weight: 600; margin-bottom: 0.3rem;">Password (min. 6 characters)</label>
                    <input @bind="_adminPassword"
                           type="password"
                           placeholder="Choose a strong password"
                           style="width: 100%; padding: 0.55rem 0.75rem; border: 1px solid #cbd5e1; border-radius: 6px;" />
                </div>
                <div>
                    <label style="display: block; font-size: 0.85rem; font-weight: 600; margin-bottom: 0.3rem;">Confirm Password</label>
                    <input @bind="_adminPasswordConfirm"
                           type="password"
                           placeholder="Repeat password"
                           style="width: 100%; padding: 0.55rem 0.75rem; border: 1px solid #cbd5e1; border-radius: 6px;" />
                </div>
            </div>

            <div style="display: flex; justify-content: flex-end; margin-top: 1.75rem;">
                <button @onclick="CompleteStep1Async"
                        style="padding: 0.7rem 1.4rem; background: #0284c7; color: white; border: none; border-radius: 6px; font-weight: 600; cursor: pointer;">
                    Save Account & Continue →
                </button>
            </div>
        </div>
    }
    else if (_step == 2)
    {
        <div style="background: white; border: 1px solid #cbd5e1; border-radius: 10px; padding: 1.75rem; margin-bottom: 1.25rem;">
            <h2 style="margin-top: 0; color: #0f172a;">🔌 Step 2: Configure Network Integrations</h2>
            <p style="font-size: 0.9rem; color: #64748b; margin-bottom: 1.5rem;">
                Connect your primary router/firewall and wireless controller for automatic topology discovery, ARP/DHCP correlation, and Wi-Fi telemetry. Per-device SSH and API credentials can also be configured directly on each device page.
            </p>

            <!-- OPNsense Section -->
            <div style="background: #f8fafc; border: 1px solid #cbd5e1; border-radius: 8px; padding: 1.25rem; margin-bottom: 1.25rem;">
                <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 0.75rem;">
                    <h3 style="margin: 0; color: #1e293b;">🔥 OPNsense Firewall & Router</h3>
                    <div style="display:flex; gap:0.5rem;">
                        <button type="button"
                                @onclick="TestOpnSenseAsync"
                                disabled="@_testingOpn"
                                style="padding: 0.4rem 0.9rem; background: #0f172a; color: white; border: none; border-radius: 6px; font-size: 0.82rem; font-weight: 600; cursor: pointer;">
                            @(_testingOpn ? "⏳ Testing..." : "🔌 Test OPNsense Connection")
                        </button>
                        <button type="button" @onclick="PrepareMigrationPreviewAsync" style="padding:0.4rem 0.9rem; background:#0f172a; color:white; border:none; border-radius:6px; font-size:0.82rem; font-weight:600;">🔁 Migrate Global Settings</button>
                    </div>
                </div>
                <p style="font-size: 0.82rem; color: #64748b; margin-top: 0;">
                    Requires an API user with permissions for Firmware, VLAN, ARP, and Kea/ISC DHCPv4.
                </p>

                <div style="display: grid; grid-template-columns: 1fr; gap: 0.85rem;">
                    <div>
                        <label style="display: block; font-size: 0.8rem; font-weight: 600; margin-bottom: 0.25rem;">Base URL</label>
                        <input @bind="_opnBaseUrl" placeholder="https://192.168.1.1" style="width: 100%; padding: 0.45rem; border: 1px solid #cbd5e1; border-radius: 6px;" />
                    </div>
                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.85rem;">
                        <div>
                            <label style="display: block; font-size: 0.8rem; font-weight: 600; margin-bottom: 0.25rem;">API Key</label>
                            <input @bind="_opnApiKey" type="password" placeholder="Paste key=..." style="width: 100%; padding: 0.45rem; border: 1px solid #cbd5e1; border-radius: 6px;" />
                        </div>
                        <div>
                            <label style="display: block; font-size: 0.8rem; font-weight: 600; margin-bottom: 0.25rem;">API Secret</label>
                            <input @bind="_opnApiSecret" type="password" placeholder="Paste secret=..." style="width: 100%; padding: 0.45rem; border: 1px solid #cbd5e1; border-radius: 6px;" />
                        </div>
                    </div>
                </div>

                @if (!string.IsNullOrEmpty(_opnTestMessage))
                {
                    <div style="margin-top: 0.75rem; padding: 0.55rem 0.8rem; border-radius: 6px; font-size: 0.82rem; background: @(_opnTestOk ? "#f0fdf4" : "#fef2f2"); border: 1px solid @(_opnTestOk ? "#86efac" : "#f87171"); color: @(_opnTestOk ? "#166534" : "#991b1b");">
                        @_opnTestMessage
                    </div>
                }
            </div>

            <!-- UniFi Section -->
            <div style="background: #f8fafc; border: 1px solid #cbd5e1; border-radius: 8px; padding: 1.25rem;">
                <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 0.75rem;">
                    <h3 style="margin: 0; color: #1e293b;">📶 Ubiquiti UniFi Network Controller</h3>
                    <button type="button"
                            @onclick="TestUniFiAsync"
                            disabled="@_testingUniFi"
                            style="padding: 0.4rem 0.9rem; background: #0f172a; color: white; border: none; border-radius: 6px; font-size: 0.82rem; font-weight: 600; cursor: pointer;">
                        @(_testingUniFi ? "⏳ Testing..." : "🔌 Test UniFi Connection")
                    </button>
                </div>
                <p style="font-size: 0.82rem; color: #64748b; margin-top: 0;">
                    Use a local Read-Only administrator or a UniFi Network 8.5+ API Key.
                </p>

                <div style="display: grid; grid-template-columns: 2fr 1fr; gap: 0.85rem; margin-bottom: 0.85rem;">
                    <div>
                        <label style="display: block; font-size: 0.8rem; font-weight: 600; margin-bottom: 0.25rem;">Controller Base URL</label>
                        <input @bind="_unifiBaseUrl" placeholder="https://192.168.1.10:8443" style="width: 100%; padding: 0.45rem; border: 1px solid #cbd5e1; border-radius: 6px;" />
                    </div>
                    <div>
                        <label style="display: block; font-size: 0.8rem; font-weight: 600; margin-bottom: 0.25rem;">Site Name</label>
                        <input @bind="_unifiSite" placeholder="default" style="width: 100%; padding: 0.45rem; border: 1px solid #cbd5e1; border-radius: 6px;" />
                    </div>
                </div>

                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.85rem; margin-bottom: 0.85rem;">
                    <div>
                        <label style="display: block; font-size: 0.8rem; font-weight: 600; margin-bottom: 0.25rem;">Username</label>
                        <input @bind="_unifiUsername" placeholder="svc_netadmin" style="width: 100%; padding: 0.45rem; border: 1px solid #cbd5e1; border-radius: 6px;" />
                    </div>
                    <div>
                        <label style="display: block; font-size: 0.8rem; font-weight: 600; margin-bottom: 0.25rem;">Password</label>
                        <input @bind="_unifiPassword" type="password" placeholder="Controller password" style="width: 100%; padding: 0.45rem; border: 1px solid #cbd5e1; border-radius: 6px;" />
                    </div>
                </div>

                <div style="display: grid; grid-template-columns: 1fr auto; gap: 0.85rem; align-items: end;">
                    <div>
                        <label style="display: block; font-size: 0.8rem; font-weight: 600; margin-bottom: 0.25rem;">API Key (Optional, UniFi Network 8.5+)</label>
                        <input @bind="_unifiApiKey" type="password" placeholder="Optional X-API-KEY" style="width: 100%; padding: 0.45rem; border: 1px solid #cbd5e1; border-radius: 6px;" />
                    </div>
                    <label style="display: flex; align-items: center; gap: 0.4rem; padding-bottom: 0.45rem; font-size: 0.82rem; font-weight: 600; cursor: pointer;">
                        <input type="checkbox" @bind="_unifiIsOs" />
                        UniFi OS (UDM / CloudKey Gen2+)
                    </label>
                </div>

                @if (!string.IsNullOrEmpty(_unifiTestMessage))
                {
                    <div style="margin-top: 0.75rem; padding: 0.55rem 0.8rem; border-radius: 6px; font-size: 0.82rem; background: @(_unifiTestOk ? "#f0fdf4" : "#fef2f2"); border: 1px solid @(_unifiTestOk ? "#86efac" : "#f87171"); color: @(_unifiTestOk ? "#166534" : "#991b1b");">
                        @_unifiTestMessage
                    </div>
                }
            </div>

            <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 1.75rem;">
                <button type="button"
                        @onclick="() => _step = 1"
                        style="padding: 0.65rem 1.2rem; background: #f1f5f9; color: #334155; border: 1px solid #cbd5e1; border-radius: 6px; font-weight: 600; cursor: pointer;">
                    ← Back
                </button>
                <div style="display: flex; gap: 0.75rem;">
                    <button type="button"
                            @onclick="CompleteStep2Async"
                            style="padding: 0.7rem 1.4rem; background: #0284c7; color: white; border: none; border-radius: 6px; font-weight: 600; cursor: pointer;">
                        Save Integrations & Continue →
                    </button>
                </div>
            </div>

            @if (_showMigrationPreview)
            {
                <div style="background: #fffbeb; border: 1px solid #fcd34d; border-radius: 8px; padding: 1rem; margin-top:1rem;">
                    <h4 style="margin:0 0 0.5rem 0;">Migration Preview</h4>
                    <p style="margin:0 0 0.5rem 0; color:#92400e;">The following global settings will be copied to device-scoped settings. Review and confirm. Global values will be cleared after migration.</p>
                    <table style="width:100%; border-collapse: collapse; margin-top:0.5rem;">
                        <thead>
                            <tr style="text-align:left; background:#fff7ed; border-bottom:1px solid #fcd34d;"><th style="padding:0.4rem">Global Key</th><th>Value</th><th>Target Device</th><th>Target Key</th></tr>
                        </thead>
                        <tbody>
                            @foreach (var it in _migrationPreview)
                            {
                                <tr style="border-bottom:1px solid #f3f4f6;"><td style="padding:0.45rem">@it.GlobalKey</td><td>@(string.IsNullOrWhiteSpace(it.Value) ? "(empty)" : it.Value)</td><td>@it.TargetDeviceName (@it.TargetDeviceId)</td><td>@it.TargetKey</td></tr>
                            }
                        </tbody>
                    </table>

                    <div style="display:flex; gap:0.5rem; justify-content:flex-end; margin-top:0.75rem;">
                        <button @onclick="CancelMigrationPreview" style="padding:0.5rem 0.9rem; background:#f1f5f9; border:1px solid #cbd5e1; border-radius:6px;">Cancel</button>
                        <button @onclick="ConfirmMigrationAsync" style="padding:0.5rem 0.9rem; background:#0f172a; color:white; border:none; border-radius:6px;">Confirm Migration</button>
                    </div>
                </div>
            }
        </div>
    }
    else if (_step == 3)
    {
        <div style="background: white; border: 1px solid #cbd5e1; border-radius: 10px; padding: 2rem; text-align: center;">
            <div style="font-size: 3rem; margin-bottom: 0.5rem;">🎉</div>
            <h2 style="margin-top: 0; color: #0f172a;">NetAdmin is Ready!</h2>
            <p style="color: #64748b; max-width: 540px; margin: 0 auto 1.5rem auto; font-size: 0.95rem;">
                Your administrator account and integration settings have been encrypted and saved in the local SQLite database. You can also configure device-specific SSH and API credentials on each device's details page.
            </p>

            <div style="max-width: 460px; margin: 0 auto 1.75rem auto; text-align: left; background: #f8fafc; border: 1px solid #cbd5e1; border-radius: 8px; padding: 1rem;">
                <div style="margin-bottom: 0.5rem; font-size: 0.9rem;">
                    <strong>👤 Administrator:</strong> @_adminUsername
                </div>
                <div style="margin-bottom: 0.5rem; font-size: 0.9rem;">
                    <strong>🔥 OPNsense Integration:</strong> @(!string.IsNullOrWhiteSpace(_opnApiKey) ? $"Configured ({_opnBaseUrl})" : "Not configured (can be added later)")
                </div>
                <div style="font-size: 0.9rem;">
                    <strong>📶 UniFi Integration:</strong> @(!string.IsNullOrWhiteSpace(_unifiUsername) || !string.IsNullOrWhiteSpace(_unifiApiKey) ? $"Configured ({_unifiBaseUrl})" : "Not configured (can be added later)")
                </div>
            </div>

            <div style="display: flex; justify-content: center; gap: 1rem;">
                <button type="button"
                        @onclick="() => _step = 2"
                        style="padding: 0.7rem 1.2rem; background: #f1f5f9; color: #334155; border: 1px solid #cbd5e1; border-radius: 6px; font-weight: 600; cursor: pointer;">
                    ← Back to Integrations
                </button>
                <button type="button"
                        @onclick="FinishOnboardingAsync"
                        style="padding: 0.75rem 1.75rem; background: #16a34a; color: white; border: none; border-radius: 6px; font-weight: 700; font-size: 1rem; cursor: pointer;">
                    🚀 Finish & Open Dashboard
                </button>
            </div>
        </div>
    }
</div>

@code {
    private int _step = 1;
    private string? _errorMessage;

    // Step 1: Admin Account
    private string _adminUsername = "admin";
    private string _adminPassword = "";
    private string _adminPasswordConfirm = "";

    // Step 2: Integrations
    private string _opnBaseUrl = "https://192.168.1.1";
    private string _opnApiKey = "";
    private string _opnApiSecret = "";
    private bool _testingOpn;
    private bool _opnTestOk;
    private string? _opnTestMessage;

    private string _unifiBaseUrl = "https://192.168.1.10:8443";
    private string _unifiSite = "default";
    private string _unifiUsername = "";
    private string _unifiPassword = "";
    private string _unifiApiKey = "";
    private bool _unifiIsOs;
    private bool _testingUniFi;
    private bool _unifiTestOk;
    private string? _unifiTestMessage;
    // Migration preview state
    private bool _showMigrationPreview;
    private List<MigrationItem> _migrationPreview = new();
    private string? _statusMessage;

    protected override async Task OnInitializedAsync()
    {
        var existingUser = await AuthService.GetAdminUsernameAsync();
        if (!string.IsNullOrWhiteSpace(existingUser))
        {
            _adminUsername = existingUser;
        }

        // Prefer device-scoped credentials if available
        await LoadDeviceSettingsAsync();
    }

    private async Task CompleteStep1Async()
    {
        _errorMessage = null;

        if (string.IsNullOrWhiteSpace(_adminUsername))
        {
            _errorMessage = "Please enter an administrator username.";
            return;
        }

        if (string.IsNullOrWhiteSpace(_adminPassword) || _adminPassword.Length < 6)
        {
            _errorMessage = "Password must be at least 6 characters long.";
            return;
        }

        if (_adminPassword != _adminPasswordConfirm)
        {
            _errorMessage = "Passwords do not match.";
            return;
        }

        await AuthService.ConfigureAdminAsync(_adminUsername, _adminPassword);
        _step = 2;
    }

    private async Task SaveIntegrationsInternalAsync()
    {
        var opn = await GetOrCreateDeviceAsync("opnsense-router", "OPNsense Firewall", HardwareCategory.Router, "", "OPNsense", "OPNsense Firewall");
        await SettingsService.SaveSettingAsync($"device:{opn.Id}:api:baseurl", string.IsNullOrWhiteSpace(_opnBaseUrl) ? null : _opnBaseUrl);
        await SettingsService.SaveSettingAsync($"device:{opn.Id}:api:key", string.IsNullOrWhiteSpace(_opnApiKey) ? null : _opnApiKey);
        await SettingsService.SaveSettingAsync($"device:{opn.Id}:api:secret", string.IsNullOrWhiteSpace(_opnApiSecret) ? null : _opnApiSecret);

        var u = await GetOrCreateDeviceAsync("unifi-controller", "UniFi Controller", HardwareCategory.Server, "", "UniFi", "UniFi Controller");
        await SettingsService.SaveSettingAsync($"device:{u.Id}:unifi:baseurl", string.IsNullOrWhiteSpace(_unifiBaseUrl) ? null : _unifiBaseUrl);
        await SettingsService.SaveSettingAsync($"device:{u.Id}:unifi:site", string.IsNullOrWhiteSpace(_unifiSite) ? null : _unifiSite);
        await SettingsService.SaveSettingAsync($"device:{u.Id}:unifi:username", string.IsNullOrWhiteSpace(_unifiUsername) ? null : _unifiUsername);
        await SettingsService.SaveSettingAsync($"device:{u.Id}:unifi:password", string.IsNullOrWhiteSpace(_unifiPassword) ? null : _unifiPassword);
        await SettingsService.SaveSettingAsync($"device:{u.Id}:unifi:apikey", string.IsNullOrWhiteSpace(_unifiApiKey) ? null : _unifiApiKey);
        await SettingsService.SaveSettingAsync($"device:{u.Id}:unifi:isunifos", _unifiIsOs ? "true" : null);
    }

    private async Task<HardwareDevice> GetOrCreateDeviceAsync(string suggestedId, string name, HardwareCategory category, string ipAddress, string vendor, string model)
    {
        var all = await HardwareProvider.GetAllHardwareAsync();
        var found = all.FirstOrDefault(d => (!string.IsNullOrWhiteSpace(d.Id) && d.Id.Contains(suggestedId, StringComparison.OrdinalIgnoreCase)) ||
                                            (!string.IsNullOrWhiteSpace(d.TagsCsv) && d.TagsCsv.Contains(suggestedId, StringComparison.OrdinalIgnoreCase)) ||
                                            (!string.IsNullOrWhiteSpace(d.Vendor) && d.Vendor.Contains(vendor, StringComparison.OrdinalIgnoreCase)));

        if (found is not null)
            return found;

        var id = suggestedId;
        var device = new HardwareDevice(
            Id: id,
            Name: name,
            Category: category,
            IpAddress: string.IsNullOrWhiteSpace(ipAddress) ? null : ipAddress,
            MacAddress: null,
            Room: "Server Closet",
            PortCount: 1,
            ManagementUrl: null,
            Notes: $"Created by onboarding for {name}",
            TagsCsv: suggestedId,
            Vendor: vendor,
            Model: model);

        await HardwareProvider.SaveHardwareAsync(device);
        return device;
    }

    private async Task LoadDeviceSettingsAsync()
    {
        try
        {
            var all = await HardwareProvider.GetAllHardwareAsync();
            var opn = all.FirstOrDefault(d => d.TagsCsv?.Contains("opnsense", StringComparison.OrdinalIgnoreCase) == true || d.Id.Contains("opnsense", StringComparison.OrdinalIgnoreCase));
            if (opn is not null)
            {
                _opnBaseUrl = await SettingsService.GetSettingAsync($"device:{opn.Id}:api:baseurl") ?? _opnBaseUrl;
                _opnApiKey = await SettingsService.GetSettingAsync($"device:{opn.Id}:api:key") ?? _opnApiKey;
                _opnApiSecret = await SettingsService.GetSettingAsync($"device:{opn.Id}:api:secret") ?? _opnApiSecret;
            }

            var u = all.FirstOrDefault(d => d.TagsCsv?.Contains("unifi", StringComparison.OrdinalIgnoreCase) == true || d.Vendor.Contains("UniFi", StringComparison.OrdinalIgnoreCase));
            if (u is not null)
            {
                _unifiBaseUrl = await SettingsService.GetSettingAsync($"device:{u.Id}:unifi:baseurl") ?? _unifiBaseUrl;
                _unifiSite = await SettingsService.GetSettingAsync($"device:{u.Id}:unifi:site") ?? _unifiSite;
                _unifiUsername = await SettingsService.GetSettingAsync($"device:{u.Id}:unifi:username") ?? _unifiUsername;
                _unifiPassword = await SettingsService.GetSettingAsync($"device:{u.Id}:unifi:password") ?? _unifiPassword;
                _unifiApiKey = await SettingsService.GetSettingAsync($"device:{u.Id}:unifi:apikey") ?? _unifiApiKey;
                _unifiIsOs = bool.TryParse(await SettingsService.GetSettingAsync($"device:{u.Id}:unifi:isunifos"), out var isOs) && isOs;
            }
        }
        catch { }
    }

    private async Task TestOpnSenseAsync()
    {
        _testingOpn = true;
        _opnTestMessage = null;
        StateHasChanged();

        try
        {
            await SaveIntegrationsInternalAsync();
            var provider = RoutingProviders.FirstOrDefault();
            _opnTestOk = provider is not null && await provider.TestConnectionAsync();
            _opnTestMessage = _opnTestOk
                ? "✅ Successfully connected to OPNsense API!"
                : "❌ Could not connect to OPNsense API. Verify Base URL, API Key, and API Secret.";
        }
        finally
        {
            _testingOpn = false;
        }
    }

    private async Task TestUniFiAsync()
    {
        _testingUniFi = true;
        _unifiTestMessage = null;
        StateHasChanged();

        try
        {
            await SaveIntegrationsInternalAsync();
            var provider = WirelessProviders.FirstOrDefault();
            _unifiTestOk = provider is not null && await provider.TestConnectionAsync();
            _unifiTestMessage = _unifiTestOk
                ? "✅ Successfully connected to UniFi Network Controller!"
                : "❌ Could not connect to UniFi Controller. Verify Base URL, Site, and credentials.";
        }
        finally
        {
            _testingUniFi = false;
        }
    }

    private async Task CompleteStep2Async()
    {
        _errorMessage = null;
        await SaveIntegrationsInternalAsync();
        _step = 3;
    }

    private async Task FinishOnboardingAsync()
    {
        await AuthService.SetOnboardingCompletedAsync(true);

        var protector = ProtectionProvider.CreateProtector("NetAdmin.Onboarding.SignIn.v1");
        var token = protector.Protect($"{_adminUsername.Trim()}|{DateTimeOffset.UtcNow.ToUnixTimeSeconds()}");
        Navigation.NavigateTo($"/auth/token-signin?token={Uri.EscapeDataString(token)}&redirect=/", forceLoad: true);
    }

    private record MigrationItem(string GlobalKey, string Value, string TargetDeviceId, string TargetDeviceName, string TargetKey);

    private async Task PrepareMigrationPreviewAsync()
    {
        _migrationPreview.Clear();
        _showMigrationPreview = false;

        try
        {
            var all = await HardwareProvider.GetAllHardwareAsync();

            var g = await SettingsService.GetSettingAsync("OpnSense:BaseUrl", "OpnSense:BaseUrl");
            var gk = await SettingsService.GetSettingAsync("OpnSense:ApiKey", "OpnSense:ApiKey");
            var gsec = await SettingsService.GetSettingAsync("OpnSense:ApiSecret", "OpnSense:ApiSecret");
            if (!string.IsNullOrWhiteSpace(g) || !string.IsNullOrWhiteSpace(gk) || !string.IsNullOrWhiteSpace(gsec))
            {
                var found = all.FirstOrDefault(d => (!string.IsNullOrWhiteSpace(d.TagsCsv) && d.TagsCsv.Contains("opnsense", StringComparison.OrdinalIgnoreCase)) || (!string.IsNullOrWhiteSpace(d.Id) && d.Id.Contains("opnsense", StringComparison.OrdinalIgnoreCase)));
                var targetId = found?.Id ?? "opnsense-router";
                var targetName = found?.Name ?? "OPNsense Firewall";
                if (!string.IsNullOrWhiteSpace(g)) _migrationPreview.Add(new MigrationItem("OpnSense:BaseUrl", g, targetId, targetName, $"device:{targetId}:api:baseurl"));
                if (!string.IsNullOrWhiteSpace(gk)) _migrationPreview.Add(new MigrationItem("OpnSense:ApiKey", "(secret)", targetId, targetName, $"device:{targetId}:api:key"));
                if (!string.IsNullOrWhiteSpace(gsec)) _migrationPreview.Add(new MigrationItem("OpnSense:ApiSecret", "(secret)", targetId, targetName, $"device:{targetId}:api:secret"));
            }

            var ubase = await SettingsService.GetSettingAsync("UniFi:BaseUrl", "UniFi:BaseUrl");
            var uuser = await SettingsService.GetSettingAsync("UniFi:Username", "UniFi:Username");
            var upass = await SettingsService.GetSettingAsync("UniFi:Password", "UniFi:Password");
            var usite = await SettingsService.GetSettingAsync("UniFi:Site", "UniFi:Site");
            if (!string.IsNullOrWhiteSpace(ubase) || !string.IsNullOrWhiteSpace(uuser) || !string.IsNullOrWhiteSpace(upass) || !string.IsNullOrWhiteSpace(usite))
            {
                var found = all.FirstOrDefault(d => (!string.IsNullOrWhiteSpace(d.TagsCsv) && d.TagsCsv.Contains("unifi", StringComparison.OrdinalIgnoreCase)) || (!string.IsNullOrWhiteSpace(d.Vendor) && d.Vendor.Contains("UniFi", StringComparison.OrdinalIgnoreCase)));
                var targetId = found?.Id ?? "unifi-controller";
                var targetName = found?.Name ?? "UniFi Controller";
                if (!string.IsNullOrWhiteSpace(ubase)) _migrationPreview.Add(new MigrationItem("UniFi:BaseUrl", ubase, targetId, targetName, $"device:{targetId}:unifi:baseurl"));
                if (!string.IsNullOrWhiteSpace(uuser)) _migrationPreview.Add(new MigrationItem("UniFi:Username", uuser, targetId, targetName, $"device:{targetId}:unifi:username"));
                if (!string.IsNullOrWhiteSpace(upass)) _migrationPreview.Add(new MigrationItem("UniFi:Password", "(secret)", targetId, targetName, $"device:{targetId}:unifi:password"));
                if (!string.IsNullOrWhiteSpace(usite)) _migrationPreview.Add(new MigrationItem("UniFi:Site", usite, targetId, targetName, $"device:{targetId}:unifi:site"));
            }

            var fbase = await SettingsService.GetSettingAsync("Frigate:BaseUrl", "Frigate:BaseUrl");
            var ftoken = await SettingsService.GetSettingAsync("Frigate:ApiToken", "Frigate:ApiToken");
            if (!string.IsNullOrWhiteSpace(fbase) || !string.IsNullOrWhiteSpace(ftoken))
            {
                var found = all.FirstOrDefault(d => (!string.IsNullOrWhiteSpace(d.TagsCsv) && d.TagsCsv.Contains("frigate", StringComparison.OrdinalIgnoreCase)) || (!string.IsNullOrWhiteSpace(d.Vendor) && d.Vendor.Contains("Frigate", StringComparison.OrdinalIgnoreCase)));
                var targetId = found?.Id ?? "frigate-nvr";
                var targetName = found?.Name ?? "Frigate NVR";
                if (!string.IsNullOrWhiteSpace(fbase)) _migrationPreview.Add(new MigrationItem("Frigate:BaseUrl", fbase, targetId, targetName, $"device:{targetId}:api:baseurl"));
                if (!string.IsNullOrWhiteSpace(ftoken)) _migrationPreview.Add(new MigrationItem("Frigate:ApiToken", "(secret)", targetId, targetName, $"device:{targetId}:api:token"));
            }

            var habase = await SettingsService.GetSettingAsync("HomeAssistant:BaseUrl", "HomeAssistant:BaseUrl");
            var hatoken = await SettingsService.GetSettingAsync("HomeAssistant:AccessToken", "HomeAssistant:AccessToken");
            if (!string.IsNullOrWhiteSpace(habase) || !string.IsNullOrWhiteSpace(hatoken))
            {
                var found = all.FirstOrDefault(d => (!string.IsNullOrWhiteSpace(d.TagsCsv) && d.TagsCsv.Contains("homeassistant", StringComparison.OrdinalIgnoreCase)) || (!string.IsNullOrWhiteSpace(d.Vendor) && d.Vendor.Contains("HomeAssistant", StringComparison.OrdinalIgnoreCase)));
                var targetId = found?.Id ?? "homeassistant";
                var targetName = found?.Name ?? "Home Assistant";
                if (!string.IsNullOrWhiteSpace(habase)) _migrationPreview.Add(new MigrationItem("HomeAssistant:BaseUrl", habase, targetId, targetName, $"device:{targetId}:api:baseurl"));
                if (!string.IsNullOrWhiteSpace(hatoken)) _migrationPreview.Add(new MigrationItem("HomeAssistant:AccessToken", "(secret)", targetId, targetName, $"device:{targetId}:api:token"));
            }

            if (_migrationPreview.Count == 0)
            {
                _statusMessage = "No global settings found to migrate.";
            }
            else
            {
                _showMigrationPreview = true;
            }
        }
        catch (Exception ex)
        {
            _errorMessage = $"Failed to prepare migration: {ex.Message}";
        }
    }

    private void CancelMigrationPreview()
    {
        _showMigrationPreview = false;
        _migrationPreview.Clear();
    }

    private async Task ConfirmMigrationAsync()
    {
        if (_migrationPreview.Count == 0)
        {
            _errorMessage = "Nothing to migrate.";
            _showMigrationPreview = false;
            return;
        }

        try
        {
            foreach (var item in _migrationPreview)
            {
                var all = await HardwareProvider.GetAllHardwareAsync();
                var found = all.FirstOrDefault(d => string.Equals(d.Id, item.TargetDeviceId, StringComparison.OrdinalIgnoreCase));
                if (found is null)
                {
                    var nameGuess = item.TargetDeviceName ?? item.TargetDeviceId;
                    await GetOrCreateDeviceAsync(item.TargetDeviceId, nameGuess, item.TargetDeviceName?.Contains("Controller") == true ? HardwareCategory.Server : HardwareCategory.Generic, "", item.TargetDeviceName ?? "", item.TargetDeviceName ?? "");
                }
                await SettingsService.SaveSettingAsync(item.TargetKey, string.IsNullOrWhiteSpace(item.Value) ? null : item.Value);
            }

            // clear globals
            await SettingsService.SaveSettingAsync("OpnSense:BaseUrl", null);
            await SettingsService.SaveSettingAsync("OpnSense:ApiKey", null);
            await SettingsService.SaveSettingAsync("OpnSense:ApiSecret", null);
            await SettingsService.SaveSettingAsync("UniFi:BaseUrl", null);
            await SettingsService.SaveSettingAsync("UniFi:Username", null);
            await SettingsService.SaveSettingAsync("UniFi:Password", null);
            await SettingsService.SaveSettingAsync("UniFi:Site", null);
            await SettingsService.SaveSettingAsync("Frigate:BaseUrl", null);
            await SettingsService.SaveSettingAsync("Frigate:ApiToken", null);
            await SettingsService.SaveSettingAsync("HomeAssistant:BaseUrl", null);
            await SettingsService.SaveSettingAsync("HomeAssistant:AccessToken", null);

            _showMigrationPreview = false;
            _migrationPreview.Clear();
            _errorMessage = null;
            _statusMessage = "✅ Migration complete — global settings copied to device-scoped settings and globals cleared.";
            await LoadDeviceSettingsAsync();
        }
        catch (Exception ex)
        {
            _errorMessage = $"Migration failed: {ex.Message}";
        }
    }
}
