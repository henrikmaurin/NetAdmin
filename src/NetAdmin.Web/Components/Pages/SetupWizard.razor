@page "/setup"
@rendermode InteractiveServer
@using NetAdmin.Core.Providers
@using NetAdmin.Core.Services
@using NetAdmin.Core.Models
@inject IEncryptedSettingsService SettingsService
@inject IAdminAuthService AuthService
@inject IEnumerable<IRoutingProvider> RoutingProviders
@inject IEnumerable<IWirelessProvider> WirelessProviders
@inject IEnumerable<IFrigateProvider> FrigateProviders
@inject IEnumerable<IHomeAssistantProvider> HomeAssistantProviders
@inject NavigationManager Navigation
@inject IHardwareInventoryProvider HardwareProvider

<PageTitle>NetAdmin - Settings & Onboarding</PageTitle>

<div style="font-family: system-ui, sans-serif; max-width: 900px; margin: 0 auto; padding: 1.5rem;">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem; flex-wrap: wrap; gap: 0.75rem;">
        <div>
            <a href="/" style="text-decoration: none; color: #0066cc; font-size: 0.9rem;">← Back to Dashboard</a>
            <h1 style="margin: 0.25rem 0 0 0;">System Settings & Connections</h1>
            <small style="color: #666;">Configure your API keys here. Values are encrypted securely in the SQLite database.</small>
        </div>
        <a href="/onboarding"
           style="padding: 0.5rem 0.95rem; background: #0f172a; color: white; text-decoration: none; border-radius: 6px; font-size: 0.85rem; font-weight: 600;">
            🧭 Run Onboarding Wizard
        </a>
    </div>

    @if (!string.IsNullOrEmpty(_statusMessage))
    {
        <div style="padding: 0.85rem 1rem; border-radius: 6px; margin-bottom: 1.5rem; background: @(_isError ? "#fef2f2" : "#f0fdf4"); border: 1px solid @(_isError ? "#f87171" : "#86efac"); color: @(_isError ? "#991b1b" : "#166534");">
            @_statusMessage
        </div>
    }

    <div style="background: white; border: 1px solid #cbd5e1; border-radius: 8px; padding: 1.5rem; margin-bottom: 1.5rem;">
        <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.5rem;">
            <h3 style="margin: 0; color: #1e293b;">🔥 OPNsense Firewall & Router</h3>
            <button type="button"
                    @onclick="TestOpnSenseAsync"
                    disabled="@_testingOpn"
                    style="padding: 0.4rem 0.9rem; background: #0f172a; color: white; border: none; border-radius: 6px; font-size: 0.82rem; font-weight: 600; cursor: pointer;">
                @(_testingOpn ? "⏳ Testing..." : "🔌 Save & Test OPNsense")
            </button>
        </div>
        <p style="font-size: 0.85rem; color: #64748b;">
            Requires an API user assigned to the <code>netadmin_api</code> privilege group (with permissions for Firmware, VLAN, ARP and Kea/ISC DHCPv4).
        </p>

        <div style="display: grid; grid-template-columns: 1fr; gap: 1rem; margin-bottom: 1rem;">
            <div>
                <label style="display: block; font-size: 0.85rem; font-weight: 600; margin-bottom: 0.3rem;">Base URL</label>
                <input @bind="_opnBaseUrl" placeholder="https://192.168.1.1" style="width: 100%; padding: 0.5rem; border: 1px solid #ccc; border-radius: 6px;" />
            </div>
            <div>
                <label style="display: block; font-size: 0.85rem; font-weight: 600; margin-bottom: 0.3rem;">API Key</label>
                <input @bind="_opnApiKey" type="password" placeholder="Paste key=..." style="width: 100%; padding: 0.5rem; border: 1px solid #ccc; border-radius: 6px;" />
            </div>
            <div>
                <label style="display: block; font-size: 0.85rem; font-weight: 600; margin-bottom: 0.3rem;">API Secret</label>
                <input @bind="_opnApiSecret" type="password" placeholder="Paste secret=..." style="width: 100%; padding: 0.5rem; border: 1px solid #ccc; border-radius: 6px;" />
            </div>
        </div>
    </div>

    <div style="background: white; border: 1px solid #cbd5e1; border-radius: 8px; padding: 1.5rem; margin-bottom: 1.5rem;">
        <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.5rem;">
            <h3 style="margin: 0; color: #1e293b;">📶 UniFi Network Controller</h3>
            <button type="button"
                    @onclick="TestUniFiAsync"
                    disabled="@_testingUniFi"
                    style="padding: 0.4rem 0.9rem; background: #0f172a; color: white; border: none; border-radius: 6px; font-size: 0.82rem; font-weight: 600; cursor: pointer;">
                @(_testingUniFi ? "⏳ Testing..." : "🔌 Save & Test UniFi")
            </button>
        </div>
        <p style="font-size: 0.85rem; color: #64748b;">
            Use a local Read-Only administrator created under <em>Settings ➔ System ➔ Administration</em> (enable <em>Restrict to Local Access Only</em>).
        </p>

        <div style="display: grid; grid-template-columns: 1fr; gap: 1rem; margin-bottom: 1rem;">
            <div>
                <label style="display: block; font-size: 0.85rem; font-weight: 600; margin-bottom: 0.3rem;">Controller Base URL</label>
                <input @bind="_unifiBaseUrl" placeholder="https://192.168.1.10:8443" style="width: 100%; padding: 0.5rem; border: 1px solid #ccc; border-radius: 6px;" />
            </div>
            <div style="display: grid; grid-template-columns: 2fr 1fr; gap: 1rem;">
                <div>
                    <label style="display: block; font-size: 0.85rem; font-weight: 600; margin-bottom: 0.3rem;">Username</label>
                    <input @bind="_unifiUsername" placeholder="svc_netadmin" style="width: 100%; padding: 0.5rem; border: 1px solid #ccc; border-radius: 6px;" />
                </div>
                <div>
                    <label style="display: block; font-size: 0.85rem; font-weight: 600; margin-bottom: 0.3rem;">Site Name</label>
                    <input @bind="_unifiSite" placeholder="default" style="width: 100%; padding: 0.5rem; border: 1px solid #ccc; border-radius: 6px;" />
                </div>
            </div>
            <div>
                <label style="display: block; font-size: 0.85rem; font-weight: 600; margin-bottom: 0.3rem;">Password</label>
                <input @bind="_unifiPassword" type="password" placeholder="Your password" style="width: 100%; padding: 0.5rem; border: 1px solid #ccc; border-radius: 6px;" />
            </div>
        </div>
    </div>

    <div style="background: white; border: 1px solid #cbd5e1; border-radius: 8px; padding: 1.5rem; margin-bottom: 1.5rem;">
        <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.5rem;">
            <h3 style="margin: 0; color: #1e293b;">🎥 Frigate NVR</h3>
            <button type="button"
                    @onclick="TestFrigateAsync"
                    disabled="@_testingFrigate"
                    style="padding: 0.4rem 0.9rem; background: #0f172a; color: white; border: none; border-radius: 6px; font-size: 0.82rem; font-weight: 600; cursor: pointer;">
                @(_testingFrigate ? "⏳ Testing..." : "🔌 Save & Test Frigate")
            </button>
        </div>
        <p style="font-size: 0.85rem; color: #64748b;">
            Connect your Frigate NVR instance to query camera FPS, AI detectors, and NVR health.
        </p>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;">
            <div>
                <label style="display: block; font-size: 0.85rem; font-weight: 600; margin-bottom: 0.3rem;">Frigate Base URL</label>
                <input @bind="_frigateBaseUrl" placeholder="http://192.168.1.50:5000" style="width: 100%; padding: 0.5rem; border: 1px solid #ccc; border-radius: 6px;" />
            </div>
            <div>
                <label style="display: block; font-size: 0.85rem; font-weight: 600; margin-bottom: 0.3rem;">Bearer Token (Optional)</label>
                <input @bind="_frigateApiToken" type="password" placeholder="Optional JWT/Proxy token" style="width: 100%; padding: 0.5rem; border: 1px solid #ccc; border-radius: 6px;" />
            </div>
        </div>
    </div>

    <div style="background: white; border: 1px solid #cbd5e1; border-radius: 8px; padding: 1.5rem; margin-bottom: 1.5rem;">
        <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.5rem;">
            <h3 style="margin: 0; color: #1e293b;">🏡 Home Assistant</h3>
            <button type="button"
                    @onclick="TestHomeAssistantAsync"
                    disabled="@_testingHa"
                    style="padding: 0.4rem 0.9rem; background: #0f172a; color: white; border: none; border-radius: 6px; font-size: 0.82rem; font-weight: 600; cursor: pointer;">
                @(_testingHa ? "⏳ Testing..." : "🔌 Save & Test Home Assistant")
            </button>
        </div>
        <p style="font-size: 0.85rem; color: #64748b;">
            Connect Home Assistant using a Long-Lived Access Token created under <em>Profile ➔ Security</em>.
        </p>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;">
            <div>
                <label style="display: block; font-size: 0.85rem; font-weight: 600; margin-bottom: 0.3rem;">Home Assistant Base URL</label>
                <input @bind="_haBaseUrl" placeholder="http://192.168.1.20:8123" style="width: 100%; padding: 0.5rem; border: 1px solid #ccc; border-radius: 6px;" />
            </div>
            <div>
                <label style="display: block; font-size: 0.85rem; font-weight: 600; margin-bottom: 0.3rem;">Long-Lived Access Token</label>
                <input @bind="_haAccessToken" type="password" placeholder="eyJhbGciOiJIUzI1NiIs..." style="width: 100%; padding: 0.5rem; border: 1px solid #ccc; border-radius: 6px;" />
            </div>
        </div>
    </div>

    <div style="display: flex; justify-content: flex-end; gap: 1rem; margin-bottom: 2rem;">
        <button @onclick="PrepareMigrationPreviewAsync"
                style="padding: 0.5rem 1rem; background: #0f172a; color: white; border: none; border-radius: 6px; cursor: pointer; font-weight: 600;">
            🔁 Migrate Global Settings To Devices
        </button>

        <button @onclick="SaveSettingsAsync"
                style="padding: 0.75rem 1.5rem; background: #16a34a; color: white; border: none; border-radius: 6px; cursor: pointer; font-weight: 600;">
            💾 Create Devices & Save Credentials
        </button>
    </div>

    @if (_showMigrationPreview)
    {
        <div style="background: #fffbeb; border: 1px solid #fcd34d; border-radius: 8px; padding: 1rem; margin-bottom: 1rem;">
            <h4 style="margin:0 0 0.5rem 0;">Migration Preview</h4>
            <p style="margin:0 0 0.5rem 0; color:#92400e;">The following global settings will be copied to device-scoped settings. Review and confirm. Global values will be cleared after migration.</p>
            <table style="width:100%; border-collapse: collapse; margin-top:0.5rem;">
                <thead>
                    <tr style="text-align:left; background:#fff7ed; border-bottom:1px solid #fcd34d;"><th style="padding:0.4rem">Global Key</th><th>Value</th><th>Target Device</th><th>Target Key</th></tr>
                </thead>
                <tbody>
                    @foreach (var it in _migrationPreview)
                    {
                        <tr style="border-bottom:1px solid #f3f4f6;"><td style="padding:0.45rem">@it.GlobalKey</td><td>@(string.IsNullOrWhiteSpace(it.Value) ? "(empty)" : it.Value)</td><td>@it.TargetDeviceName (@it.TargetDeviceId)</td><td>@it.TargetKey</td></tr>
                    }
                </tbody>
            </table>

            <div style="display:flex; gap:0.5rem; justify-content:flex-end; margin-top:0.75rem;">
                <button @onclick="CancelMigrationPreview" style="padding:0.5rem 0.9rem; background:#f1f5f9; border:1px solid #cbd5e1; border-radius:6px;">Cancel</button>
                <button @onclick="ConfirmMigrationAsync" style="padding:0.5rem 0.9rem; background:#0f172a; color:white; border:none; border-radius:6px;">Confirm Migration</button>
            </div>
        </div>
    }

    <div style="background: white; border: 1px solid #cbd5e1; border-radius: 8px; padding: 1.5rem;">
        <h3 style="margin-top: 0; color: #1e293b;">👤 Administrator Account</h3>
        <p style="font-size: 0.85rem; color: #64748b;">
            Update the local administrator username or password used to sign in to NetAdmin.
        </p>

        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 1rem; margin-bottom: 1rem;">
            <div>
                <label style="display: block; font-size: 0.85rem; font-weight: 600; margin-bottom: 0.3rem;">Admin Username</label>
                <input @bind="_adminUsername" placeholder="admin" style="width: 100%; padding: 0.5rem; border: 1px solid #ccc; border-radius: 6px;" />
            </div>
            <div>
                <label style="display: block; font-size: 0.85rem; font-weight: 600; margin-bottom: 0.3rem;">New Password</label>
                <input @bind="_newAdminPassword" type="password" placeholder="Min. 6 characters" style="width: 100%; padding: 0.5rem; border: 1px solid #ccc; border-radius: 6px;" />
            </div>
        </div>

        <button @onclick="UpdateAdminCredentialsAsync"
                style="padding: 0.6rem 1.2rem; background: #0284c7; color: white; border: none; border-radius: 6px; cursor: pointer; font-weight: 600;">
            🔐 Update Administrator Credentials
        </button>
    </div>
</div>

@code {
    private string _opnBaseUrl = string.Empty;
    private string _opnApiKey = string.Empty;
    private string _opnApiSecret = string.Empty;

    private string _unifiBaseUrl = string.Empty;
    private string _unifiUsername = string.Empty;
    private string _unifiPassword = string.Empty;
    private string _unifiSite = "default";

    private string _frigateBaseUrl = string.Empty;
    private string _frigateApiToken = string.Empty;

    private string _haBaseUrl = string.Empty;
    private string _haAccessToken = string.Empty;

    private string _adminUsername = "admin";
    private string _newAdminPassword = string.Empty;

    private bool _testingOpn;
    private bool _testingUniFi;
    private bool _testingFrigate;
    private bool _testingHa;
    private string? _statusMessage;
    private bool _isError;
    // Migration preview state
    private bool _showMigrationPreview;
    private List<MigrationItem> _migrationPreview = new();

    protected override async Task OnInitializedAsync()
    {
        // Load device-scoped credentials if devices exist; prefer per-device settings over global settings.
        await LoadDeviceSettingsAsync();

        _adminUsername = await AuthService.GetAdminUsernameAsync() ?? "admin";
    }

    private async Task SaveSettingsAsync()
    {
        try
        {
            // Create or find devices and store credentials per-device instead of global settings.
            var opn = await GetOrCreateDeviceAsync("opnsense-router", "OPNsense Firewall", HardwareCategory.Router, "", "OPNsense", "OPNsense Firewall");
            await SettingsService.SaveSettingAsync($"device:{opn.Id}:api:baseurl", string.IsNullOrWhiteSpace(_opnBaseUrl) ? null : _opnBaseUrl);
            await SettingsService.SaveSettingAsync($"device:{opn.Id}:api:key", string.IsNullOrWhiteSpace(_opnApiKey) ? null : _opnApiKey);
            await SettingsService.SaveSettingAsync($"device:{opn.Id}:api:secret", string.IsNullOrWhiteSpace(_opnApiSecret) ? null : _opnApiSecret);

            var u = await GetOrCreateDeviceAsync("unifi-controller", "UniFi Controller", HardwareCategory.Server, "", "UniFi", "UniFi Controller");
            await SettingsService.SaveSettingAsync($"device:{u.Id}:unifi:baseurl", string.IsNullOrWhiteSpace(_unifiBaseUrl) ? null : _unifiBaseUrl);
            await SettingsService.SaveSettingAsync($"device:{u.Id}:unifi:username", string.IsNullOrWhiteSpace(_unifiUsername) ? null : _unifiUsername);
            await SettingsService.SaveSettingAsync($"device:{u.Id}:unifi:password", string.IsNullOrWhiteSpace(_unifiPassword) ? null : _unifiPassword);
            await SettingsService.SaveSettingAsync($"device:{u.Id}:unifi:site", string.IsNullOrWhiteSpace(_unifiSite) ? null : _unifiSite);

            var f = await GetOrCreateDeviceAsync("frigate-nvr", "Frigate NVR", HardwareCategory.Nvr, "", "Frigate", "Frigate NVR");
            await SettingsService.SaveSettingAsync($"device:{f.Id}:api:baseurl", string.IsNullOrWhiteSpace(_frigateBaseUrl) ? null : _frigateBaseUrl);
            await SettingsService.SaveSettingAsync($"device:{f.Id}:api:token", string.IsNullOrWhiteSpace(_frigateApiToken) ? null : _frigateApiToken);

            var ha = await GetOrCreateDeviceAsync("homeassistant", "Home Assistant", HardwareCategory.HomeAutomation, "", "HomeAssistant", "Home Assistant");
            await SettingsService.SaveSettingAsync($"device:{ha.Id}:api:baseurl", string.IsNullOrWhiteSpace(_haBaseUrl) ? null : _haBaseUrl);
            await SettingsService.SaveSettingAsync($"device:{ha.Id}:api:token", string.IsNullOrWhiteSpace(_haAccessToken) ? null : _haAccessToken);

            _isError = false;
            _statusMessage = "✅ Devices created/updated and credentials saved per-device (encrypted).";
        }
        catch (Exception ex)
        {
            _isError = true;
            _statusMessage = $"❌ Failed to save settings: {ex.Message}";
        }
    }

    private async Task TestOpnSenseAsync()
    {
        _testingOpn = true;
        StateHasChanged();
        try
        {
            await SaveSettingsAsync();
            var provider = RoutingProviders.FirstOrDefault();
            var ok = provider is not null && await provider.TestConnectionAsync();
            _isError = !ok;
            _statusMessage = ok
                ? "✅ Settings saved and OPNsense API connection verified!"
                : "❌ Settings saved, but could not connect to OPNsense API.";
        }
        finally
        {
            _testingOpn = false;
        }
    }

    private async Task TestUniFiAsync()
    {
        _testingUniFi = true;
        StateHasChanged();
        try
        {
            await SaveSettingsAsync();
            var provider = WirelessProviders.FirstOrDefault();
            var ok = provider is not null && await provider.TestConnectionAsync();
            _isError = !ok;
            _statusMessage = ok
                ? "✅ Settings saved and UniFi Network Controller connection verified!"
                : "❌ Settings saved, but could not connect to UniFi Controller.";
        }
        finally
        {
            _testingUniFi = false;
        }
    }

    private async Task TestFrigateAsync()
    {
        _testingFrigate = true;
        StateHasChanged();
        try
        {
            await SaveSettingsAsync();
            var provider = FrigateProviders.FirstOrDefault();
            var status = provider is not null ? await provider.GetStatusAsync() : null;
            _isError = status is null;
            _statusMessage = status is not null
                ? $"✅ Settings saved and Frigate v{status.Version} connection verified ({status.CameraCount} cameras)!"
                : "❌ Settings saved, but could not connect to Frigate API.";
        }
        finally
        {
            _testingFrigate = false;
        }
    }

    private async Task TestHomeAssistantAsync()
    {
        _testingHa = true;
        StateHasChanged();
        try
        {
            await SaveSettingsAsync();
            var provider = HomeAssistantProviders.FirstOrDefault();
            var status = provider is not null ? await provider.GetStatusAsync() : null;
            _isError = status is null;
            _statusMessage = status is not null
                ? $"✅ Settings saved and Home Assistant v{status.Version} ({status.LocationName}) verified!"
                : "❌ Settings saved, but could not connect to Home Assistant API.";
        }
        finally
        {
            _testingHa = false;
        }
    }

    private async Task UpdateAdminCredentialsAsync()
    {
        if (string.IsNullOrWhiteSpace(_adminUsername) || string.IsNullOrWhiteSpace(_newAdminPassword) || _newAdminPassword.Length < 6)
        {
            _isError = true;
            _statusMessage = "❌ Username is required and password must be at least 6 characters.";
            return;
        }

        await AuthService.ConfigureAdminAsync(_adminUsername, _newAdminPassword);
        _newAdminPassword = string.Empty;
        _isError = false;
        _statusMessage = "✅ Administrator account credentials updated!";
    }

    // Finds an existing device by common signals (id, vendor, tags) or creates a new one with the provided defaults.
    private async Task<HardwareDevice> GetOrCreateDeviceAsync(string suggestedId, string name, HardwareCategory category, string ipAddress, string vendor, string model)
    {
        var all = await HardwareProvider.GetAllHardwareAsync();
        var found = all.FirstOrDefault(d => (!string.IsNullOrWhiteSpace(d.Id) && d.Id.Contains(suggestedId, StringComparison.OrdinalIgnoreCase)) ||
                                            (!string.IsNullOrWhiteSpace(d.TagsCsv) && d.TagsCsv.Contains(suggestedId, StringComparison.OrdinalIgnoreCase)) ||
                                            (!string.IsNullOrWhiteSpace(d.Vendor) && d.Vendor.Contains(vendor, StringComparison.OrdinalIgnoreCase)));

        if (found is not null)
            return found;

        var id = suggestedId;
        var device = new HardwareDevice(
            Id: id,
            Name: name,
            Category: category,
            IpAddress: string.IsNullOrWhiteSpace(ipAddress) ? null : ipAddress,
            MacAddress: null,
            Room: "Server Closet",
            PortCount: 1,
            ManagementUrl: null,
            Notes: $"Created by onboarding for {name}",
            TagsCsv: suggestedId,
            Vendor: vendor,
            Model: model);

        await HardwareProvider.SaveHardwareAsync(device);
        return device;
    }

    // Try to load existing device-scoped settings and populate the onboarding fields.
    private async Task LoadDeviceSettingsAsync()
    {
        try
        {
            var all = await HardwareProvider.GetAllHardwareAsync();

            var opn = all.FirstOrDefault(d => d.TagsCsv?.Contains("opnsense", StringComparison.OrdinalIgnoreCase) == true || d.Id.Contains("opnsense", StringComparison.OrdinalIgnoreCase));
            if (opn is not null)
            {
                _opnBaseUrl = await SettingsService.GetSettingAsync($"device:{opn.Id}:api:baseurl") ?? string.Empty;
                _opnApiKey = await SettingsService.GetSettingAsync($"device:{opn.Id}:api:key") ?? string.Empty;
                _opnApiSecret = await SettingsService.GetSettingAsync($"device:{opn.Id}:api:secret") ?? string.Empty;
            }

            var u = all.FirstOrDefault(d => d.TagsCsv?.Contains("unifi", StringComparison.OrdinalIgnoreCase) == true || d.Vendor.Contains("UniFi", StringComparison.OrdinalIgnoreCase));
            if (u is not null)
            {
                _unifiBaseUrl = await SettingsService.GetSettingAsync($"device:{u.Id}:unifi:baseurl") ?? string.Empty;
                _unifiUsername = await SettingsService.GetSettingAsync($"device:{u.Id}:unifi:username") ?? string.Empty;
                _unifiPassword = await SettingsService.GetSettingAsync($"device:{u.Id}:unifi:password") ?? string.Empty;
                _unifiSite = await SettingsService.GetSettingAsync($"device:{u.Id}:unifi:site") ?? _unifiSite;
            }

            var f = all.FirstOrDefault(d => d.TagsCsv?.Contains("frigate", StringComparison.OrdinalIgnoreCase) == true || d.Vendor.Contains("Frigate", StringComparison.OrdinalIgnoreCase));
            if (f is not null)
            {
                _frigateBaseUrl = await SettingsService.GetSettingAsync($"device:{f.Id}:api:baseurl") ?? string.Empty;
                _frigateApiToken = await SettingsService.GetSettingAsync($"device:{f.Id}:api:token") ?? string.Empty;
            }

            var ha = all.FirstOrDefault(d => d.TagsCsv?.Contains("homeassistant", StringComparison.OrdinalIgnoreCase) == true || d.Vendor.Contains("HomeAssistant", StringComparison.OrdinalIgnoreCase));
            if (ha is not null)
            {
                _haBaseUrl = await SettingsService.GetSettingAsync($"device:{ha.Id}:api:baseurl") ?? string.Empty;
                _haAccessToken = await SettingsService.GetSettingAsync($"device:{ha.Id}:api:token") ?? string.Empty;
            }
        }
        catch { }
    }

    private record MigrationItem(string GlobalKey, string Value, string TargetDeviceId, string TargetDeviceName, string TargetKey);

    // Prepare a preview of what would be migrated. This collects global values and the target mapping but does not modify data.
    private async Task PrepareMigrationPreviewAsync()
    {
        _migrationPreview.Clear();
        _showMigrationPreview = false;

        try
        {
            var all = await HardwareProvider.GetAllHardwareAsync();

            // OPNsense
            var g = await SettingsService.GetSettingAsync("OpnSense:BaseUrl", "OpnSense:BaseUrl");
            var gk = await SettingsService.GetSettingAsync("OpnSense:ApiKey", "OpnSense:ApiKey");
            var gsec = await SettingsService.GetSettingAsync("OpnSense:ApiSecret", "OpnSense:ApiSecret");
            if (!string.IsNullOrWhiteSpace(g) || !string.IsNullOrWhiteSpace(gk) || !string.IsNullOrWhiteSpace(gsec))
            {
                var found = all.FirstOrDefault(d => (!string.IsNullOrWhiteSpace(d.TagsCsv) && d.TagsCsv.Contains("opnsense", StringComparison.OrdinalIgnoreCase)) || (!string.IsNullOrWhiteSpace(d.Id) && d.Id.Contains("opnsense", StringComparison.OrdinalIgnoreCase)));
                var targetId = found?.Id ?? "opnsense-router";
                var targetName = found?.Name ?? "OPNsense Firewall";
                if (!string.IsNullOrWhiteSpace(g)) _migrationPreview.Add(new MigrationItem("OpnSense:BaseUrl", g, targetId, targetName, $"device:{targetId}:api:baseurl"));
                if (!string.IsNullOrWhiteSpace(gk)) _migrationPreview.Add(new MigrationItem("OpnSense:ApiKey", "(secret)", targetId, targetName, $"device:{targetId}:api:key"));
                if (!string.IsNullOrWhiteSpace(gsec)) _migrationPreview.Add(new MigrationItem("OpnSense:ApiSecret", "(secret)", targetId, targetName, $"device:{targetId}:api:secret"));
            }

            // UniFi
            var ubase = await SettingsService.GetSettingAsync("UniFi:BaseUrl", "UniFi:BaseUrl");
            var uuser = await SettingsService.GetSettingAsync("UniFi:Username", "UniFi:Username");
            var upass = await SettingsService.GetSettingAsync("UniFi:Password", "UniFi:Password");
            var usite = await SettingsService.GetSettingAsync("UniFi:Site", "UniFi:Site");
            if (!string.IsNullOrWhiteSpace(ubase) || !string.IsNullOrWhiteSpace(uuser) || !string.IsNullOrWhiteSpace(upass) || !string.IsNullOrWhiteSpace(usite))
            {
                var found = all.FirstOrDefault(d => (!string.IsNullOrWhiteSpace(d.TagsCsv) && d.TagsCsv.Contains("unifi", StringComparison.OrdinalIgnoreCase)) || (!string.IsNullOrWhiteSpace(d.Vendor) && d.Vendor.Contains("UniFi", StringComparison.OrdinalIgnoreCase)));
                var targetId = found?.Id ?? "unifi-controller";
                var targetName = found?.Name ?? "UniFi Controller";
                if (!string.IsNullOrWhiteSpace(ubase)) _migrationPreview.Add(new MigrationItem("UniFi:BaseUrl", ubase, targetId, targetName, $"device:{targetId}:unifi:baseurl"));
                if (!string.IsNullOrWhiteSpace(uuser)) _migrationPreview.Add(new MigrationItem("UniFi:Username", uuser, targetId, targetName, $"device:{targetId}:unifi:username"));
                if (!string.IsNullOrWhiteSpace(upass)) _migrationPreview.Add(new MigrationItem("UniFi:Password", "(secret)", targetId, targetName, $"device:{targetId}:unifi:password"));
                if (!string.IsNullOrWhiteSpace(usite)) _migrationPreview.Add(new MigrationItem("UniFi:Site", usite, targetId, targetName, $"device:{targetId}:unifi:site"));
            }

            // Frigate
            var fbase = await SettingsService.GetSettingAsync("Frigate:BaseUrl", "Frigate:BaseUrl");
            var ftoken = await SettingsService.GetSettingAsync("Frigate:ApiToken", "Frigate:ApiToken");
            if (!string.IsNullOrWhiteSpace(fbase) || !string.IsNullOrWhiteSpace(ftoken))
            {
                var found = all.FirstOrDefault(d => (!string.IsNullOrWhiteSpace(d.TagsCsv) && d.TagsCsv.Contains("frigate", StringComparison.OrdinalIgnoreCase)) || (!string.IsNullOrWhiteSpace(d.Vendor) && d.Vendor.Contains("Frigate", StringComparison.OrdinalIgnoreCase)));
                var targetId = found?.Id ?? "frigate-nvr";
                var targetName = found?.Name ?? "Frigate NVR";
                if (!string.IsNullOrWhiteSpace(fbase)) _migrationPreview.Add(new MigrationItem("Frigate:BaseUrl", fbase, targetId, targetName, $"device:{targetId}:api:baseurl"));
                if (!string.IsNullOrWhiteSpace(ftoken)) _migrationPreview.Add(new MigrationItem("Frigate:ApiToken", "(secret)", targetId, targetName, $"device:{targetId}:api:token"));
            }

            // Home Assistant
            var habase = await SettingsService.GetSettingAsync("HomeAssistant:BaseUrl", "HomeAssistant:BaseUrl");
            var hatoken = await SettingsService.GetSettingAsync("HomeAssistant:AccessToken", "HomeAssistant:AccessToken");
            if (!string.IsNullOrWhiteSpace(habase) || !string.IsNullOrWhiteSpace(hatoken))
            {
                var found = all.FirstOrDefault(d => (!string.IsNullOrWhiteSpace(d.TagsCsv) && d.TagsCsv.Contains("homeassistant", StringComparison.OrdinalIgnoreCase)) || (!string.IsNullOrWhiteSpace(d.Vendor) && d.Vendor.Contains("HomeAssistant", StringComparison.OrdinalIgnoreCase)));
                var targetId = found?.Id ?? "homeassistant";
                var targetName = found?.Name ?? "Home Assistant";
                if (!string.IsNullOrWhiteSpace(habase)) _migrationPreview.Add(new MigrationItem("HomeAssistant:BaseUrl", habase, targetId, targetName, $"device:{targetId}:api:baseurl"));
                if (!string.IsNullOrWhiteSpace(hatoken)) _migrationPreview.Add(new MigrationItem("HomeAssistant:AccessToken", "(secret)", targetId, targetName, $"device:{targetId}:api:token"));
            }

            if (_migrationPreview.Count == 0)
            {
                _isError = false;
                _statusMessage = "No global settings found to migrate.";
            }
            else
            {
                _showMigrationPreview = true;
            }
        }
        catch (Exception ex)
        {
            _isError = true;
            _statusMessage = $"Failed to prepare migration: {ex.Message}";
        }
    }

    private void CancelMigrationPreview()
    {
        _showMigrationPreview = false;
        _migrationPreview.Clear();
    }

    // Perform the migration that was previewed. Copies preview items into device-scoped settings and clears globals.
    private async Task ConfirmMigrationAsync()
    {
        if (_migrationPreview.Count == 0)
        {
            _statusMessage = "Nothing to migrate.";
            _showMigrationPreview = false;
            return;
        }

        try
        {
            // Ensure devices exist for each target
            foreach (var item in _migrationPreview)
            {
                // If the target device id doesn't exist yet, create it with a sensible name
                var all = await HardwareProvider.GetAllHardwareAsync();
                var found = all.FirstOrDefault(d => string.Equals(d.Id, item.TargetDeviceId, StringComparison.OrdinalIgnoreCase));
                if (found is null)
                {
                    // create device with basic metadata based on target id
                    var nameGuess = item.TargetDeviceName ?? item.TargetDeviceId;
                    await GetOrCreateDeviceAsync(item.TargetDeviceId, nameGuess, item.TargetDeviceName?.Contains("Controller") == true ? HardwareCategory.Server : HardwareCategory.Generic, "", item.TargetDeviceName ?? "", item.TargetDeviceName ?? "");
                }
                // Save to device-scoped key
                await SettingsService.SaveSettingAsync(item.TargetKey, string.IsNullOrWhiteSpace(item.Value) ? null : item.Value);
            }

            // clear the known global keys
            await SettingsService.SaveSettingAsync("OpnSense:BaseUrl", null);
            await SettingsService.SaveSettingAsync("OpnSense:ApiKey", null);
            await SettingsService.SaveSettingAsync("OpnSense:ApiSecret", null);
            await SettingsService.SaveSettingAsync("UniFi:BaseUrl", null);
            await SettingsService.SaveSettingAsync("UniFi:Username", null);
            await SettingsService.SaveSettingAsync("UniFi:Password", null);
            await SettingsService.SaveSettingAsync("UniFi:Site", null);
            await SettingsService.SaveSettingAsync("Frigate:BaseUrl", null);
            await SettingsService.SaveSettingAsync("Frigate:ApiToken", null);
            await SettingsService.SaveSettingAsync("HomeAssistant:BaseUrl", null);
            await SettingsService.SaveSettingAsync("HomeAssistant:AccessToken", null);

            _isError = false;
            _statusMessage = "✅ Migration complete — global settings copied to device-scoped settings and globals cleared.";
            _showMigrationPreview = false;
            _migrationPreview.Clear();
            await LoadDeviceSettingsAsync();
        }
        catch (Exception ex)
        {
            _isError = true;
            _statusMessage = $"Migration failed: {ex.Message}";
        }
    }
}
