@using Microsoft.AspNetCore.Components
@using NetAdmin.Core.Models

@if (Device is IoTHubHardwareDevice hub)
{
    <div class="card-summary card-summary--iothub">
        <div><strong>@hub.Vendor @hub.HubModel</strong> (@(hub.PortCount > 0 ? $"{hub.PortCount} LAN-port" : "Wi-Fi"))</div>
        @if (!string.IsNullOrWhiteSpace(hub.SupportedProtocolsCsv))
        {
            <div style="margin-top: 0.2rem; display: flex; flex-wrap: wrap; gap: 0.25rem;">
                @foreach (var proto in hub.SupportedProtocolsCsv.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
                {
                    @TagBadge($"📡 {proto}")
                }
            </div>
        }
    </div>
}

@inherits NetAdmin.Core.Components.DeviceComponentBase
